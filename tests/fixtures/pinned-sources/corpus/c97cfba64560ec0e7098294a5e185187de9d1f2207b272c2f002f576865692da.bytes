            }
          },
          "required": [
            "op",
            "arg"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "typeIs"
            },
            "binding": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "type": {
              "type": "string",
              "minLength": 1
            },
            "mode": {
              "enum": [
                "exact",
                "assignable"
              ]
            }
          },
          "required": [
            "op",
            "binding",
            "type",
            "mode"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "present"
            },
            "value": {
