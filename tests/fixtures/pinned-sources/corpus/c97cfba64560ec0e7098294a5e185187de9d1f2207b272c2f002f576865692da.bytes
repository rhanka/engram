{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:profile-mechanism:1:profile",
  "title": "Profile mechanism 1.0.0 — closed profile data",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "urn:profile-mechanism:1:profile"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "mechanismVersion": {
      "const": "1"
    },
    "profile": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.:/-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "base": {
      "$ref": "#/$defs/pin"
    },
    "descriptors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pin"
      },
      "minItems": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "predicates/1",
          "selectors/1",
          "recipes/1",
          "profile-lint/1",
          "render-data/1",
          "export-ir/1"
        ]
      },
      "uniqueItems": true,
      "minItems": 6,
      "maxItems": 6
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canonical": {
          "const": "profile-c14n/2"
        },
        "allocator": {
          "const": "stable-id/1"
        },
        "whitespace": {
          "const": "ecma262-2024"
        },
        "textFit": {
          "const": "engine-scalar-A/1"
        },
        "unknownFields": {
          "const": "reject"
        },
        "compatibility": {
          "const": "exact-or-explicit-migration/1"
        },
        "localeFallback": {
          "type": "string",
          "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
        }
      },
      "required": [
        "canonical",
        "allocator",
        "whitespace",
        "textFit",
        "unknownFields",
        "compatibility",
        "localeFallback"
      ]
    },
    "producerDelta": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/producerDelta"
      },
      "minItems": 0
    },
    "notions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/notion"
      },
      "minItems": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      },
      "minItems": 0
    },
    "recipes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recipe"
      },
      "minItems": 0
    },
    "placements": {
      "type": "array",
      "maxItems": 0
    },
    "themes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/theme"
      },
      "minItems": 1
    },
    "ui": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/surface"
      },
      "minItems": 0
    },
    "validation": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lintPhase"
      },
      "minItems": 1
    },
    "providerDialects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provider"
      },
      "minItems": 0
    },
    "exports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exportSpec"
      },
      "minItems": 0
    },
    "migrations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/migration"
      },
      "minItems": 0
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      },
      "minItems": 0
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/message"
      },
      "minItems": 0
    },
    "compatibilityAliases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "placement",
              "theme",
              "export",
              "marker",
              "metadata"
            ]
          },
          "old": {
            "type": "string",
            "minLength": 1
          },
          "destination": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "explicit-import",
              "explicit-adapter",
              "remove"
            ]
          }
        },
        "required": [
          "kind",
          "old",
          "destination",
          "mode"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "mechanismVersion",
    "profile",
    "version",
    "base",
    "descriptors",
    "capabilities",
    "policies",
    "producerDelta",
    "notions",
    "rules",
    "recipes",
    "placements",
    "themes",
    "ui",
    "validation",
    "providerDialects",
    "exports",
    "migrations",
    "resources",
    "messages",
    "compatibilityAliases"
  ],
  "$defs": {
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.:/-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
