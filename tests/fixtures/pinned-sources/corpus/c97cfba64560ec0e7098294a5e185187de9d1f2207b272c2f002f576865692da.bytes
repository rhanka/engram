            },
            "path": {
              "type": "string",
              "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
            }
          },
          "required": [
            "op",
            "binding",
            "path"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "id"
            },
            "binding": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          },
          "required": [
            "op",
            "binding"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "param"
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          },
          "required": [
            "op",
            "name"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "concat"
            },
            "values": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              },
              "minItems": 1
            }
          },
          "required": [
            "op",
            "values"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "outputId"
            },
            "binding": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "domain": {
              "enum": [
                "page",
                "node",
                "edge",
                "label"
              ]
            }
          },
          "required": [
            "op",
            "binding",
            "domain"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "ids"
            },
            "select": {
              "$ref": "#/$defs/selector"
            }
          },
          "required": [
            "op",
            "select"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "stripPrefix"
            },
            "value": {
              "$ref": "#/$defs/value"
            },
            "prefix": {
              "type": "string",
              "minLength": 1
            },
            "trim": {
              "enum": [
                "none",
                "ecma262-2024-start"
              ]
            }
          },
          "required": [
            "op",
            "value",
            "prefix",
            "trim"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "case"
            },
            "value": {
              "$ref": "#/$defs/value"
            },
            "mode": {
              "enum": [
                "upper",
                "lower"
              ]
            },
            "unicode": {
              "const": "15.0.0"
            }
          },
          "required": [
            "op",
            "value",
            "mode",
            "unicode"
          ]
        }
      ]
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "via": {
          "enum": [
            "self",
            "root",
            "owner",
            "children",
            "descendants",
            "reference",
            "inverseReference",
            "all",
            "pages",
            "occurrences",
            "semantic"
          ]
        },
        "property": {
          "type": "string",
          "minLength": 1
        },
        "where": {
          "$ref": "#/$defs/predicate"
        },
        "order": {
          "enum": [
            "id",
            "page-occurrence"
          ]
        }
      },
      "required": [
        "from",
        "via",
        "where",
        "order"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "via": {
                "enum": [
                  "pages",
                  "occurrences"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "order": {
                "const": "page-occurrence"
              }
            }
          },
          "else": {
            "if": {
              "properties": {
                "via": {
                  "enum": [
                    "self",
                    "reference"
                  ]
                }
              }
            },
            "then": {},
            "else": {
              "properties": {
                "order": {
                  "const": "id"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "via": {
                "enum": [
                  "reference",
                  "inverseReference"
                ]
              }
            }
          },
          "then": {
            "required": [
              "property"
            ]
          },
          "else": {
            "if": {
              "properties": {
                "via": {
                  "const": "children"
                }
              }
            },
            "then": {},
            "else": {
              "not": {
                "required": [
                  "property"
                ]
              }
            }
          }
        }
      ]
    },
    "predicate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "true"
            }
          },
          "required": [
            "op"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "false"
            }
          },
          "required": [
            "op"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "all"
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/predicate"
              },
              "minItems": 1
            }
          },
          "required": [
            "op",
            "args"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "any"
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/predicate"
              },
              "minItems": 1
            }
          },
          "required": [
            "op",
            "args"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "not"
            },
            "arg": {
