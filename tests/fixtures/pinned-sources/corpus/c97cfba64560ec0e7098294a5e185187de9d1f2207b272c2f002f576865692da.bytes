              "maximum": 1.7976931348623157e+308,
              "allOf": [
                {
                  "not": {
                    "type": "integer",
                    "anyOf": [
                      {
                        "exclusiveMinimum": 9007199254740991
                      },
                      {
                        "exclusiveMaximum": -9007199254740991
                      }
                    ]
                  }
                }
              ]
            }
          },
          "required": [
            "op",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "read"
            },
            "binding": {
              "type": "string",
