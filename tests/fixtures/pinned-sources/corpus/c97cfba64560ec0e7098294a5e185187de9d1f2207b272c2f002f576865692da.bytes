                "none",
                "ecma262-2024-start"
              ]
            }
          },
          "required": [
            "op",
            "value",
            "prefix",
            "trim"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "count"
            },
