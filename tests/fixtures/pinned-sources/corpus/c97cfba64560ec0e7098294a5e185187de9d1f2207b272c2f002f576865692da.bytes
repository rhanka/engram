              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "op",
            "select",
            "min"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "boundRole"
            },
            "binding": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "owner": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "role": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.:/-]*$"
            }
          },
          "required": [
            "op",
            "binding",
            "owner",
            "role"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
