  "sourceText": "module.exports = {\n  rules: {\n    'ad-hoc-sub-process': 'error',\n    'conditional-flows': 'error',\n    'end-event-required': 'error',\n    'event-based-gateway': 'error',\n    'event-sub-process-typed-start-event': 'error',\n    'fake-join': 'warn',\n    'global': 'warn',\n    'label-required': 'error',\n    'link-event': 'error',\n    'no-bpmndi': 'error',\n    'no-complex-gateway': 'error',\n    'no-disconnected': 'error',\n    'no-duplicate-sequence-flows': 'error',\n    'no-gateway-join-fork': 'error',\n    'no-implicit-split': 'error',\n    'no-implicit-end': 'error',\n    'no-implicit-start': 'error',\n    'no-inclusive-gateway': 'warn',\n    'no-overlapping-elements': 'warn',\n    'single-blank-start-event': 'error',\n    'single-event-definition': 'error',\n    'start-event-required': 'error',\n    'sub-process-blank-start-event': 'error',\n    'superfluous-gateway': 'warn',\n    'superfluous-label': 'warn',\n    'superfluous-termination': 'warn'\n  }\n};\n",
  "rules": {
    "ad-hoc-sub-process": "error",
    "conditional-flows": "error",
    "end-event-required": "error",
    "event-based-gateway": "error",
    "event-sub-process-typed-start-event": "error",
    "fake-join": "warn",
    "global": "warn",
    "label-required": "error",
    "link-event": "error",
    "no-bpmndi": "error",
    "no-complex-gateway": "error",
    "no-disconnected": "error",
    "no-duplicate-sequence-flows": "error",
    "no-gateway-join-fork": "error",
    "no-implicit-split": "error",
    "no-implicit-end": "error",
    "no-implicit-start": "error",
    "no-inclusive-gateway": "warn",
    "no-overlapping-elements": "warn",
    "single-blank-start-event": "error",
    "single-event-definition": "error",
    "start-event-required": "error",
    "sub-process-blank-start-event": "error",
    "superfluous-gateway": "warn",
    "superfluous-label": "warn",
    "superfluous-termination": "warn"
  }
}
