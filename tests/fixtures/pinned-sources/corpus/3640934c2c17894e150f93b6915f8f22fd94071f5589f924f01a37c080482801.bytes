        {
          "binding": "self",
          "path": "",
          "mode": "placement"
        }
      ],
      "steps": [
        {
          "op": "bind",
          "as": "owner",
          "select": {
            "from": "self",
            "via": "owner",
            "where": {
              "op": "true"
            },
            "order": "id"
          },
          "cardinality": "one"
        },
        {
          "op": "place",
          "target": "self",
          "owner": "owner",
          "region": "content",
          "related": {
            "from": "root",
            "via": "all",
            "where": {
              "op": "false"
            },
            "order": "id"
          }
        }
      ]
    },
    {
      "id": "link",
      "phase": "reference",
      "parameters": [
        {
          "name": "owner",
          "type": "element",
          "required": true
        },
        {
          "name": "source",
          "type": "element",
          "required": true
        },
        {
          "name": "target",
          "type": "element",
          "required": true
        },
        {
          "name": "key",
          "type": "string",
          "required": true
        }
      ],
      "select": {
        "from": "owner",
        "via": "self",
        "where": {
          "op": "true"
        },
        "order": "id"
      },
      "when": {
        "op": "true"
      },
      "writes": [
        {
          "binding": "owner",
          "path": "/artifacts",
          "mode": "create"
        },
        {
          "binding": "edge",
          "path": "/sourceRef",
          "mode": "reference"
        },
        {
          "binding": "edge",
          "path": "/targetRef",
          "mode": "reference"
        }
      ],
      "steps": [
        {
          "op": "create",
          "as": "edge",
          "type": "bpmn:Association",
          "parent": "owner",
          "property": "artifacts",
          "slot": "link",
          "key": {
            "op": "param",
            "name": "key"
          },
          "fields": [
            {
              "name": "associationDirection",
              "value": {
                "op": "literal",
                "value": "None"
              }
            }
          ]
        },
        {
          "op": "assignRef",
          "target": "edge",
          "path": "/sourceRef",
          "values": [
            {
              "op": "id",
              "binding": "source"
            }
          ],
          "mode": "replace"
        },
        {
          "op": "assignRef",
          "target": "edge",
          "path": "/targetRef",
          "values": [
            {
              "op": "id",
              "binding": "target"
            }
          ],
          "mode": "replace"
        }
      ]
    },
    {
      "id": "export-pages",
      "phase": "export",
      "parameters": [],
      "select": {
        "from": "render",
        "via": "pages",
        "where": {
          "op": "true"
