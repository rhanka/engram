      ]
    },
    {
      "id": "aid",
      "labels": [
        {
          "name": "en",
          "value": "aid"
        }
      ],
      "citations": [],
      "nativeTypes": [
        "bpmn:TextAnnotation"
      ],
      "recognition": {
        "op": "all",
        "args": [
          {
            "op": "typeIs",
            "binding": "self",
            "type": "bpmn:TextAnnotation",
            "mode": "exact"
          },
          {
            "op": "textPrefix",
            "value": {
              "op": "read",
              "binding": "self",
              "path": "/text"
            },
            "prefix": "[Aid]",
            "trim": "none"
          }
        ]
      },
      "exclusiveGroup": "primary",
      "ai": {
        "description": "Synthetic profile example for schema review; no customer vocabulary.",
        "examples": [],
        "counterexamples": [],
        "producers": [
          "editor",
