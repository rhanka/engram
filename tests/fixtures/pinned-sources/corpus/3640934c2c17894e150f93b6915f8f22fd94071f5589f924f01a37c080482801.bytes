  ],
  "rules": [
    {
      "id": "task-named",
      "phase": "post",
      "select": {
        "from": "root",
        "via": "all",
        "where": {
          "op": "typeIs",
          "binding": "self",
          "type": "bpmn:Task",
          "mode": "exact"
        },
        "order": "id"
      },
      "assert": {
        "op": "all",
        "args": [
          {
            "op": "present",
            "value": {
              "op": "read",
              "binding": "self",
              "path": "/name"
            }
          },
          {
            "op": "not",
            "arg": {
              "op": "equal",
              "left": {
                "op": "read",
                "binding": "self",
                "path": "/name"
              },
              "right": {
                "op": "literal",
                "value": ""
              }
            }
          }
        ]
      },
      "code": "task-name-missing",
      "message": "invalid",
      "classification": "readiness"
    }
  ],
  "recipes": [
    {
      "id": "create-task",
      "phase": "create",
      "parameters": [
        {
          "name": "owner",
          "type": "element",
          "required": true
        },
        {
          "name": "key",
          "type": "string",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        }
      ],
      "select": {
        "from": "owner",
        "via": "self",
        "where": {
          "op": "true"
        },
        "order": "id"
      },
      "when": {
        "op": "true"
      },
      "writes": [
        {
          "binding": "owner",
          "path": "/flowElements",
          "mode": "create"
        }
      ],
      "steps": [
        {
          "op": "create",
          "as": "created",
          "type": "bpmn:Task",
          "parent": "owner",
          "property": "flowElements",
          "slot": "task",
          "key": {
            "op": "param",
            "name": "key"
          },
          "fields": [
            {
              "name": "name",
              "value": {
                "op": "param",
                "name": "name"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "create-aid",
      "phase": "create",
      "parameters": [
        {
          "name": "owner",
          "type": "element",
          "required": true
        },
        {
          "name": "key",
          "type": "string",
          "required": true
        },
        {
          "name": "body",
          "type": "string",
          "required": true
        }
      ],
      "select": {
        "from": "owner",
        "via": "self",
        "where": {
          "op": "true"
        },
        "order": "id"
      },
      "when": {
        "op": "true"
      },
      "writes": [
        {
          "binding": "owner",
          "path": "/artifacts",
          "mode": "create"
        }
      ],
      "steps": [
        {
          "op": "create",
          "as": "created",
          "type": "bpmn:TextAnnotation",
          "parent": "owner",
          "property": "artifacts",
          "slot": "aid",
          "key": {
            "op": "param",
            "name": "key"
          },
          "fields": [
            {
              "name": "text",
              "value": {
                "op": "concat",
                "values": [
                  {
                    "op": "literal",
                    "value": "[Aid] "
                  },
                  {
                    "op": "param",
                    "name": "body"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "rename",
      "phase": "edit",
      "parameters": [
        {
          "name": "target",
          "type": "element",
          "required": true
        },
        {
          "name": "name",
          "type": "string",
          "required": true
        }
      ],
      "select": {
        "from": "target",
        "via": "self",
        "where": {
          "op": "true"
        },
        "order": "id"
      },
      "when": {
        "op": "true"
      },
      "writes": [
        {
          "binding": "self",
          "path": "/name",
          "mode": "set"
        }
      ],
      "steps": [
        {
          "op": "set",
          "target": "self",
          "path": "/name",
          "value": {
            "op": "param",
            "name": "name"
          }
        }
      ]
    },
    {
      "id": "complete-process",
      "phase": "complete",
      "parameters": [],
      "select": {
        "from": "root",
        "via": "all",
        "where": {
          "op": "typeIs",
          "binding": "self",
          "type": "bpmn:Process",
          "mode": "exact"
        },
        "order": "id"
      },
      "when": {
        "op": "true"
      },
      "writes": [
        {
          "binding": "self",
          "path": "/isExecutable",
          "mode": "set"
        }
      ],
      "steps": [
        {
          "op": "set",
          "target": "self",
          "path": "/isExecutable",
          "value": {
            "op": "literal",
            "value": false
          }
        }
      ]
    },
    {
      "id": "place-task",
      "phase": "normalize",
      "parameters": [],
