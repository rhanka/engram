  "sceneLegendPassages": {
    "S2-asbuilt": [
      "Red frames: Chat sessions in `InMemorySessionService` keyed by the space name (lost on restart, shared in group spaces), no event check or dedup, corpus admin tools callable by any user, user text logged at INFO; absent: citations, 1–5 feedback, eligibility check, Drive sync."
    ],
    "S2-target": [
      "Colours: blue = GenAiR template kept unchanged; yellow = existing HRPN code kept; orange = new or changed in the target (eligibility before retrieval, HR prompt with read-only tools, link formatter for Workspace links (HR05), 1–5 rating as `feedback_score` into the sink and the BigQuery linked dataset, PII-scrubbed conversation log kept 1 year (HR04), Model Armor, governed ingestion Drive → GCS → RAG import (HR02)); no fill = Google or third-party managed service. HR01 = A without ChatUI: no web channel, so no load balancer, IAP or ADK web UI; Agent Engine, admin tools, template bucket and template Firestore `hrpn-datapipelines` are not drawn (removal list: decision dossier §9.7)."
    ],
    "S1-conversational": [
      "Red frames: no GenAiR production template, IaC or CI path for Conversational Agents (GenAiR-Cutter offers Cloud Run / Agent Engine only; console build and zip restore), the Dialogflow ↔ Chat connection was rejected in POD (`auth.creds.useNormalUserEUC`, handover §C, observed with Dialogflow ES), the Apps Script route needs a VPC-SC ingress rule per user identity. The PoC agent export was not found: `source-gap`."
    ],
    "S3-agentfactory": [
      "Red frames: Agent Engine POD-only, not in the production landing zone (HR master ARD note 2026-02-27, to recheck); Gemini Enterprise planned Q4 2026, not SEC4AI-assessed; Agent Runtime under VPC-SC needs `min_instances` ≥ 1; PSL spoke template end 2026, retrofit required."
    ]
  }
