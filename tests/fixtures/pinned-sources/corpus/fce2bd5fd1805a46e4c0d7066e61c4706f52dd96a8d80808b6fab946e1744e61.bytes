arnais · outils h2a"],"function":["annotate, Track, Focus, sessions, etc."],"detail":["Outils h2a · annotation via comments"]},"fontScale":1.7142857142857142,"cardIcon":"link","kicker":"MCP · OUTILS","cardFooter":"service: Sentropic","status":null,"cardTier":"service","layoutHeight":200}},{"id":"mcp-tools","parentId":"cat-mcp","position":{"x":1534,"y":1111.1437500000002},"width":460,"height":200,"data":{"title":"Mémoires/ontologies","function":"6 outils mémoire · ontology_call","detail":"Contrats mémoire et ontologies","tone":"proposal","kind":"component","layoutWidth":460,"text":{"title":["Mémoires/ontologies"],"function":["6 outils mémoire · ontology_call"],"detail":["Contrats mémoire et ontologies"]},"fontScale":1.7142857142857142,"cardIcon":"link","kicker":"MCP · OUTILS","cardFooter":"service: Sentropic","status":null,"cardTier":"service","layoutHeight":200}},{"id":"mcp-connectors","parentId":"cat-mcp","position":{"x":2154,"y":1111.1437500000002},"width":460,"height":200,"data":{"title":"Connecteurs à broker","function":"Gmail · GChat · Atlassian · GitHub","detail":"Notion·Slack·OpenERP·WaveApps·Stripe","tone":"proposal","kind":"component","layoutWidth":460,"text":{"title":["Connecteurs à broker"],"function":["Gmail · GChat · Atlassian · GitHub"],"detail":["Notion·Slack·OpenERP·WaveApps·Stripe"]},"fontScale":1.7142857142857142,"cardIcon":"link","kicker":"MCP · OUTILS","cardFooter":"service: Sentropic","status":null,"cardTier":"service","layoutHeight":200}},{"id":"cat-ai","parentId":"cm-catalog","position":{"x":914,"y":1487.1437500000002},"width":460,"height":200,"data":{"title":"Catalogue IA","function":"LLM, juge, vision/SAM-YOLO, TTS, STT","detail":"Mesh/gateway; JEV branche; IA à valider","tone":"proposal","kind":"component","layoutWidth":460,"text":{"title":["Catalogue IA"],"function":["LLM, juge, vision/SAM-YOLO, TTS, STT"],"detail":["Mesh/gateway; JEV branche; IA à valider"]},"fontScale":1.7142857142857142,"cardIcon":"brain","kicker":"CATALOGUE","cardFoote