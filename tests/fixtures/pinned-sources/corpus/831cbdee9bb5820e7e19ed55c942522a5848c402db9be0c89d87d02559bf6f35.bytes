eight:var(--st-component-badge-fontWeight)}.decision-details tbody tr:last-child td{border-block-end:0}.decision-details tr>:last-child{border-inline-end:0}.remark-thread{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);border:1px solid var(--st-semantic-border-subtle, #cbd5e1);border-radius:0;background:var(--st-semantic-surface-default, #fff)}.thread-entry{display:grid;align-content:start;gap:var(--st-spacing-2, .5rem);min-width:0;padding:var(--st-spacing-4, 1rem)}.owner-entry{border-inline-start:4px solid var(--st-semantic-feedback-warning, #d97706)}.response-entry{border-inline-start:1px solid var(--st-semantic-border-subtle, #cbd5e1);background:var(--st-semantic-surface-subtle, #f8fafc)}.remark-thread p,.round-history span{line-height:var(--st-typography-field-lineHeight);white-space:pre-wrap}.verbatim{font-family:var(--st-font-mono, ui-monospace, SFMono-Regular, monospace);font-size:var(--st-typography-label-size)}.empty-remark{grid-template-columns:auto 1fr;align-items:center;gap:var(--st-spacing-3, .75rem);padding:var(--st-spacing-3, .75rem);border-inline-start:4px solid var(--st-semantic-border-strong, #94a3b8)}.round-history ol{display:grid;gap:var(--st-spacing-2, .5rem);padding:0;list-style:none}.round-history li{display:grid;grid-template-columns:auto 1fr;align-items:center;gap:var(--st-spacing-3, .75rem);padding-block:var(--st-spacing-2, .5rem);border-block-end:1px solid var(--st-semantic-border-subtle, #cbd5e1)}.muted-copy,.dossier small{color:var(--st-semantic-text-secondary, #475569)}@media(max-width:75rem){.option-grid{grid-template-columns:1fr}.stage-rail{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:48rem){.st-container--padded{padding-inline:var(--st-spacing-4, 1rem)}.dossier{padding-block-start:.75rem}.dossier .st-badge{max-width:100%;white-space:normal}.fact-grid,.trust-grid,.maturity-grid,.option-grid{grid-template-columns:minmax(0,1fr)}.architecture-figure{padding:var(--st-spacing-2)}.diagram-hint{display:block}.diagram-scroll{max-height:65svh;overflow-y:auto}.dossier textarea{font-size:var(--st-typography-field-size)}.flow-canvas{height:70vh;min-height:34rem}.level-strip,.stage-rail{grid-template-columns:1fr}.dossier-nav{justify-content:center}.dossier-nav .st-slideIndicator{order:1;width:100%;flex-wrap:wrap;justify-content:center;gap:var(--st-spacing-1)}.dossier .dossier-nav .st-slideIndicator button.st-slideIndicator__dot{position:relative;min-width:44px;width:44px;height:44px;background:transparent}.dossier-nav .st-slideIndicator__dot:after{content:"";position:absolute;inset:50% auto auto 50%;transform:translate(-50%,-50%);width:1rem;height:.3125rem;border-radius:var(--st-radius-full, 999px);background:var(--st-semantic-border-strong)}.dossier-nav .st-slideIndicator__dot--current:after{width:1.75rem;background:var(--st-semantic-action-primary)}.empty-remark,.round-history li{grid-template-columns:minmax(0,1fr)}.remark-thread{grid-template-columns:1fr}.response-entry{border-inline-start:4px solid var(--st-semantic-feedback-success, #15803d);border-block-start:1px solid var(--st-semantic-border-subtle, #cbd5e1)}}.supporting-detail{border-top:1px solid var(--muted, #cbd5e1);padding:12px 0}.supporting-detail>summary{cursor:pointer;font-size:var(--st-typography-field-size);font-weight:var(--st-component-badge-fontWeight)}.supporting-detail[open]>summary{margin-bottom:8px}.architecture-svg{margin-inline:auto}.architecture-svg [data-route-state=dimmed],.architecture-svg [data-route-state=active]{opacity:1}.architecture-svg [data-route-state=active]>rect{stroke-width:3}.architecture-svg [data-route-state=active]>.diagram-arrow{stroke:var(--st-semantic-text-primary)}.need-selector-bar,.gigogne-selector-bar{display:flex;flex-wrap:wrap;gap:var(--st-spacing-2)}.central-workspace{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--st-spacing-4, 1rem);align-items:start}.route-steps{margin:0;padding-inline-start:1.25rem;display:grid;gap:.35rem;line-height:var(--st-typography-field-lineHeight)}.readiness-strip{display:flex;flex-wrap:wrap;gap:.4rem}.clause-list{display:grid;gap:var(--st-spacing-2, .5rem)}@media(max-width:75rem){.central-workspace{grid-template-columns:minmax(0,1fr)}}.owner-feedback-annex{display:grid;gap:var(--st-spacing-2, .5rem)}.verbatim-raw{margin:0;padding:var(--st-spacing-3, .75rem);border:1px solid var(--st-semantic-border-subtle, #cbd5e1);background:var(--st-semantic-surface-default, #fff);font-family:var(--st-font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);font-size:var(--st-typography-label-size);line-height:var(--st-typography-field-lineHeight);white-space:pre-wrap;overflow-wrap:anywhere;word-break:break-word}.owner-feedback-images{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,22rem),1fr));gap:var(--st-spacing-4, 1rem)}.owner-feedback-images figure{margin:0;min-width:0}.owner-feedback-images img{display:block;width:100%;height:auto}.dossier{--st-spacing-1: 4px;--st-spacing-2: 8px;--st-spacing-3: 8px;--st-spacing-4: 12px}.dossier .st-card,.dossier .st-tile{padding:12px}.fact-grid,.trust-grid,.maturity-grid,.option-grid{align-items:start}.dossier .st-flex[style*="flex-direction: column"]{justify-content:flex-start}.decision-details,.decision-diagram,.supporting-detail{padding-block:8px}.thread-entry{padding:12px}.language-switch{display:inline-flex;gap:var(--st-spacing-1,4px);padding:var(--st-spacing-1,4px);border:1px solid var(--st-semantic-border-subtle);border-radius:var(--st-radius-sm,4px);background:var(--st-semantic-surface-subtle)}
</style>
  </head>
  <body>
    <section id="portable-fallback" aria-label="Aperçu du dossier" style="padding:var(--st-spacing-4,1rem);font-family:var(--st-font-sans,system-ui,sans-serif)">
  <h1>Gouvernance des quatre projets</h1>
  <p>G1, G2, G3 et H1 sont actés. Restent la carte de capacités à valider et la mise en œuvre à qualifier.</p>
  <p role="status">Ouverture du dossier… Si cet aperçu reste affiché, ouvrir le fichier HTML téléchargé dans Chrome ou Firefox.</p>
</section><div id="app"></div>
  </body>
</html>
