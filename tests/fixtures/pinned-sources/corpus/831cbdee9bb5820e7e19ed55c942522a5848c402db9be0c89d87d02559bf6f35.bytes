tion(f,w){return arguments.length>0?((!w||p||v)&&x(w?d():f),f):d()})}var g=!1,A=((a&ss)!==0?zr:Rn)(()=>(g=!1,d()));l&&n(A);var k=ge;return(function(f,w){if(arguments.length>0){const L=w?n(A):l?Mt(f):f;return z(A,L),g=!0,s!==void 0&&(s=L),f}return wa&&g||(k.f&Gt)!==0?A.v:n(A)})}function wi(e){Dt===null&&Wl(),ta(()=>{const t=Cr(e);if(typeof t=="function")return t})}const Ei="5";typeof window<"u"&&((window.__svelte??={}).v??=new Set).add(Ei);const Hi="Contributors",Di="Count",Ii="Dimension",Mi="ORGANISATION",Fi="SERVICE",ji="CATALOGUE",Ti="STORAGE",Oi="TRUST",Ri="PROVIDERS",Ni="KNOWLEDGE",qi="Annotation",_i="Diagram",Bi="items",zi="calls",Gi="authorisation",Ui="feedback",Wi=" Governance",Vi="Ontologies",Qi="Card",Ji="of",Ki="Next",Yi="choices",Xi="Fit",$i="Enlarge",Zi="Close",ec="Architecture",tc="Dossier",ac="Qualification",rc="Collapse",oc="Resources",nc="Organisation",lc="missing",sc="Choice",ic="Items",cc="Calls",uc="Authorisation",dc="Feedback",pc="Artifacts",mc="SemanticDocument",ro={"Décisions et suites":"Decisions and next steps","G1 répartit les responsabilités ; G2 sépare profils et moteur de diagramme ; G3 confie la présentation d’annotate au Design System et les données à Sentropic.":"G1 assigns responsibilities; G2 separates profiles from the diagram engine; G3 assigns annotate presentation to Design System and data to Sentropic.","H1 · Acté le 19 octobre 2026 : « il faut prevoir les 2 ». Chaque application Sentropic doit permettre l’hébergement des artefacts sur un sous-domaine ou sur un domaine distinct.":"H1 · Accepted on 19 October 2026: « il faut prevoir les 2 ». Each Sentropic app must support artifact hosting on a subdomain or a separate domain.","Le propriétaire doit fournir sa carte de capacités. Les quatre responsables de projet doivent qualifier les intégrations avant leur adoption.":"The owner must provide their capability map. The four project leads must qualify integrations before adoption.","Capacités à valider":"Capabilities awaiting approval","Proposition à confronter à la carte du propriétaire. Chaque ligne désigne un seul responsable d’intégration ; les autres projets contribuent.":"Proposal to compare with the owner's map. Each row names one integration owner; the other projects contribute.","Responsable proposé":"Proposed owner",Contributeurs:Hi,"C01 · Organisation humains et agents":"C01 · Human and agent organization","C02 · Livraison gouvernée":"C02 · Governed delivery","C03 · Décisions du propriétaire":"C03 · Owner decisions","C04 · Traçabilité jusqu’à la production":"C04 · Traceability to production","C05 · Mémoire des agents":"C05 · Agent memory","C06 · Connaissance du code et de Git":"C06 · Code and Git knowledge","C07 · Architecture et ontologies":"C07 · Architecture and ontologies","C08 · Découverte et distribution":"C08 · Discovery and distribution","C10 · Modèles et artefacts":"C10 · Models and artifacts","C12 · Identité et accès":"C12 · Identity and access","C13 · Exécution IA et appareils":"C13 · AI and device execution","C14 · Apprentissage et références de temps":"C14 · Learning and time references","Sentropic · Engram · chaque dépôt":"Sentropic · Engram · each repository","Engram gouverne les profils ; les responsables métier en approuvent le sens. Le Design System publie le moteur, la mise en page et le rendu. Les consommateurs doivent qualifier ensemble le moteur et les profils épinglés, sans second modèle.":"Engram governs profiles; domain owners approve their meaning. Design System publishes the engine, layout and rendering. Consumers must qualify the engine and pinned profiles together, without a second model.","La mémoire en premier":"Memory first","Sentropic doit qualifier l’hôte MCP avec les six outils mémoire d’Engram avant l’exposition au catalogue. Les travaux sur les ontologies ne bloquent pas cette étape. Engram reste responsable de la mémoire et des références de temps D1=C ; h2a fournit le contexte de session.":"Sentropic must qualify the MCP host with Engram's six memory tools before catalog exposure. Ontology work does not block this step. Engram remains responsible for memory and D1=C time references; h2a supplies session context.","Qui fait quoi ensuite ?":"Who does what next?","Les décisions sont prises ; la mise en œuvre reste à qualifier. Conserver la dernière version qualifiée jusqu’à validation de chaque remplacement.":"Decisions are settled; implementation still needs qualification. Keep the last qualified version until each replacement is validated.",Étape:"Stage","Résultat attendu":"Expected outcome","M1 · Mémoire":"M1 · Memory","Qualifier les six outils mémoire avant le catalogue.":"Qualify the six memory tools before the catalog.","M2 · Contrats et catalogue":"M2 · Contracts and catalog","Les quatre projets":"All four projects","Appliquer G1–G3 ; publier les canvas au catalogue et via MCP, sur artifacts, avec les deux modes d’hébergement H1.":"Apply G1–G3; publish canvases in the catalog and through MCP, hosted on artifacts, with both H1 hosting modes.","Qualifier la capture, la résolution et la persistance, avec contrôle des accès.":"Qualify capture, resolution and persistence with access controls.","M4 · Diagrammes":"M4 · Diagrams","Remplacer l’adaptateur provisoire par le moteur publié et les profils épinglés.":"Replace the provisional adapter with the published engine and pinned profiles.","M5–M6 · Livraison et transferts":"M5–M6 · Delivery and transfers","Chaque dépôt et application destinataire":"Each repository and receiving application","Prouver séparément publication, installation et acceptation ; faire acquitter les transferts par les destinataires.":"Prove publication, installation and acceptance separately; have recipients acknowledge transfers.","Gouvernance des quatre projets":"Shared project governance","G1, G2, G3 et H1 sont actés. Restent la carte de capacités à valider et la mise en œuvre à qualifier.":"G1, G2, G3 and H1 are settled. The capability map still needs approval and the implementation needs qualification.","Unification long terme de la gouvernance h2a · engram · sentropic · design-system":"Long-term governance unification · h2a · Engram · Sentropic · Design System","Demandes verbatim du propriétaire (OWNER-REQUEST.md + owner-sketch.jpg, 2026-10-18) : (1) « Je voudrais mettre un diagramme au coeur d un contrat long terme d unification de la gouvernance h2a engram sentropic et design system. Lance une etude la dessus. Decision dossier avec diagramme au centre permettant de router les besoins comme annotate / annotation etc » ; (2) « Il faudra associer les capabilities à l'ensemble du système : mémoire agentique, traçabilité end to end des demandes jusque mise en prod, décisions et architecture, organisation humains et agents... » ; (3) « Je dois encore fournir la capability map mais tu peux en donner en premier. Je pense aussi aux canvas ui / artefacts ». — Arbitrages verbatim sur les diagrammes (owner-diagram-decisions-via-hcond.md, 2026-10-18) : (1) « Les algo open licence libre ou algo public mais dans notre js a nous … On respect mais on libere au max et on a nos propres souches » ; (2) « diagrammes gigogne (ouvrables) … Tout diagramme est un graph et toute representation est une forme de synthese. Il faut bie modeliser diagramme layout et skills de presentation » ; (3) « L enjeu n est pas la taille mais la reactivité et l atomicité des editions … la acapacite offline sans cdn doit etre possible donc ok la 32Mo qd js embedb ». — Arbitrage verbatim après round 3 de revue Sol (OWNER-REQUEST.md:13-17, 2026-10-18) : (1) sur U1 : « Question très mal posée. Les canvas (ui+interaction ia) doivent être dans le catalogue, exposé avec un mcp, hosté par dessus artefact et potentiellement ui en prod. Mais j'imagine que le modèle d'annotation doit être annotation + annotate j'imagine un modèle de donnée. A voir où tu gères la mise en catalog et mcp » ; (2) sur la scène de trace demande→prod : « Écoute je veux voir le decision dossier pour pouvoir juger est nécessaire ».":"Owner’s verbatim requests (OWNER-REQUEST.md + owner-sketch.jpg, 2026-10-18): (1) « Je voudrais mettre un diagramme au coeur d un contrat long terme d unification de la gouvernance h2a engram sentropic et design system. Lance une etude la dessus. Decision dossier avec diagramme au centre permettant de router les besoins comme annotate / annotation etc »; (2) « Il faudra associer les capabilities à l'ensemble du système : mémoire agentique, traçabilité end to end des demandes jusque mise en prod, décisions et architecture, organisation humains et agents... »; (3) « Je dois encore fournir la capability map mais tu peux en donner en premier. Je pense aussi aux canvas ui / artefacts ». — Verbatim diagram decisions (owner-diagram-decisions-via-hcond.md, 2026-10-18): (1) « Les algo open licence libre ou algo public mais dans notre js a nous … On respect mais on libere au max et on a nos propres souches »; (2) « diagrammes gigogne (ouvrables) … Tout diagramme est un graph et toute representation est une forme de synthese. Il faut bie modeliser diagramme layout et skills de presentation »; (3) « L enjeu n est pas la taille mais la reactivité et l atomicité des editions … la acapacite offline sans cdn doit etre possible donc ok la 32Mo qd js embedb ». — Verbatim decisions after Sol review round 3 (OWNER-REQUEST.md:13-17, 2026-10-18): (1) on U1: « Question très mal posée. Les canvas (ui+interaction ia) doivent être dans le catalogue, exposé avec un mcp, hosté par dessus artefact et potentiellement ui en prod. Mais j'imagine que le modèle d'annotation doit être annotation + annotate j'imagine un modèle de donnée. A voir où tu gères la mise en catalog et mcp »; (2) on the request-to-production trace scene: « Écoute je veux voir le decision dossier pour pouvoir juger est nécessaire ».","Responsabilité par acte et garde des accès (Accountability & Custody)":"Accountability for each act and access custody","Contrat quadripartite (h2a · engram · sentropic · design-system)":"Four-party contract (h2a · Engram · Sentropic · Design System)","Table de la Capability Map C01–C14 (un seul responsable principal par ligne) et séparation conducteur / auteur / relecteur / contrôle.":"Capability Map C01–C14 (one accountable owner per row), with separate conductor, author, reviewer and control roles.","Registres d’autorité et projections explicites":"Authoritative records and explicit projections","h2a · engram · sentropic":"h2a · Engram · Sentropic","Track conserve le journal append-only des demandes rattachées à un lot (WP), des décisions et des preuves (.track/events.jsonl) ; engram conserve le journal mémoire canonique (D3) et le service central des références de temps (D1=C) ; chaque dépôt et hôte conserve ses faits de code, de release et de déploiement ; chaque application conserve ses données métier. Toute projection (.engram/graph.json, carte Focus, entrée de catalogue) déclare sa source, sa version, sa fraîcheur et ses limites sans jamais prévaloir sur le registre d’autorité. Selon OWNER-REQUEST.md et ../cluster-mesh-storage/OWNER-ORIENTATIONS.md, Sentropic/cluster-mesh porte l’interface de sérialisation DB neutre avec trois surfaces optimisées : transactionnel, analytique et graphe live. SQLite et Postgres sont prioritaires. La sérialisation des modèles (graphe live en base, annotations, états, documents/vues) est distincte des bundles et releases d’artefacts. Les éléments Postgres/S3 #684 observés ne qualifient pas le contrat cible ; chaque surface nécessite ses propres preuves. Spanner, Iceberg et Neo4j restent des adaptateurs supplémentaires sans livraison attestée ; la sérialisation S3 à faible fréquence reste une piste à étudier.":"Track keeps the append-only log of requests attached to workpackages (WPs), decisions and evidence (.track/events.jsonl). Engram keeps the canonical memory log (D3) and central time reference service (D1=C). Each repository and host keeps its code, release and deployment facts; each application keeps its business data. Every projection (.engram/graph.json, Focus card, catalogue entry) declares its source, version, freshness and limits, and never overrides the authoritative record. Under OWNER-REQUEST.md and ../cluster-mesh-storage/OWNER-ORIENTATIONS.md, Sentropic/cluster-mesh owns a neutral DB serialization interface with three optimised surfaces: transactional, analytical and live graph. SQLite and Postgres have priority. Model serialization (live graph in the database, annotations, states, documents/views) is separate from artifact bundles and releases. The observed Postgres/S3 #684 implementation does not qualify the target contract; each surface needs its own evidence. Spanner, Iceberg and Neo4j remain additional adapters without demonstrated delivery; low-frequency S3 serialization remains an option to study.","Catalogue N01–N33 et plans A à E ; preuves distinctes pour les surfaces transactionnelle, analytique et graphe live, et séparation de la cible neutre avec l’implémentation Postgres/S3 observée.":"Catalogue N01–N33 and plans A–E; separate evidence for transactional, analytical and live graph surfaces; a clear distinction between the neutral target and the observed Postgres/S3 implementation.","Règles de changement des contrats partagés":"Rules for changing shared contracts","Propriétaires des domaines & co-propriétaires de frontière":"Domain owners and shared-boundary co-owners","Toute modification d’un contrat partagé part de la dernière version acceptée, identifie les producteurs, les consommateurs et les migrations de données, et met à jour simultanément les exemples, les jeux d’essai figés (fixtures) et les preuves de compatibilité (STUDY → VOL → EVOL). Le propriétaire du domaine autorise le changement sémantique ; les co-propriétaires de la frontière gèlent conjointement le contrat partagé ; aucune étiquette « documentation seule » ne permet de contourner un changement de contrat.":"Every shared-contract change starts from the latest accepted version, identifies producers, consumers and data migrations, and updates examples, frozen test fixtures and compatibility evidence together (STUDY → VOL → EVOL). The domain owner authorises the semantic change; boundary co-owners jointly freeze the shared contract. Calling a change “documentation only” never bypasses a contract change.","Contrôles harness check scope|branch et empreintes SHA-256 des contrats aux coutures.":"harness check scope|branch checks and SHA-256 fingerprints of contracts at integration boundaries.","Un seul catalogue logique, canvas (UI + interaction IA) sur artifacts/UI prod, et emplacement de la mise en catalogue et du MCP":"One logical catalogue, canvases (UI + AI interaction) on artifacts/production UI, and ownership of catalogue and MCP registration","sentropic (cluster-mesh) + dépôts producteurs (design-system · h2a · engram)":"Sentropic (cluster-mesh) and producer repositories (Design System · h2a · Engram)",'Catalogue types.ts:22 (kind="canvas"), registre MCP synchrone registry.ts:61, @sentropic/artifacts 0.1.1 et adaptateurs createClusterMeshAppAdapter / createMcpAuth.':'Catalogue types.ts:22 (kind="canvas"), synchronous MCP registry registry.ts:61, @sentropic/artifacts 0.1.1, and createClusterMeshAppAdapter / createMcpAuth adapters.',"Garde des ontologies par Engram (WP9), paternité métier, anglais et langue utilisateur BCP 47":"Engram ontology custody (WP9), domain authorship, English identifiers and BCP 47 user languages","engram (gardien WP9) + propriétaires métier":"Engram (WP9 custodian) and domain owners","Engram détient l’identité des profils, leur validation, leur composition, les jeux d’essai figés par empreinte SHA-256 et les migrations. Chaque propriétaire métier approuve le sens de son vocabulaire (track/focus par h2a, rendu par le DS). Les contrats bpmn-moddle F1 et profile-c14n/2 sont préservés sans second modèle. Règle linguistique acquise : tous les nouveaux identifiants techniques sont en anglais (merged, deployed, retry, conflictPosture), l’affichage suit la langue utilisateur BCP 47, et les valeurs françaises historiques persistées dans .track/events.jsonl (mergé, déployé, relance) sont résolues par une table d’alias de lecture à vie sans jamais réécrire le journal append-only.":"Engram owns profile identity, validation, composition, test fixtures frozen by SHA-256 fingerprint, and migrations. Each domain owner approves the meaning of its vocabulary (track/focus by h2a, rendering by Design System). The bpmn-moddle F1 and profile-c14n/2 contracts remain intact, with no second model. The agreed language rule is that all new technical identifiers use English (merged, deployed, retry, conflictPosture), display follows the user’s BCP 47 language, and historical French values persisted in .track/events.jsonl (mergé, déployé, relance) are resolved through a permanent read-alias table without rewriting the append-only log.","Modules src/ontology-profile.ts, src/profile-validate.ts, src/merge-graphs.ts dans engram et résolution K-07.":"Engram modules src/ontology-profile.ts, src/profile-validate.ts and src/merge-graphs.ts, and resolution K-07.","Versionnement, compatibilité N/N−1, rejet des majeurs inconnus et intégrité SHA-256":"Versioning, N/N−1 compatibility, rejection of unknown major versions and SHA-256 integrity","Contrat quadripartite":"Four-party contract","Le contrat distingue la version SemVer du paquet, la version majeure du schéma de document, la version du profil d’ontologie, la version de canonicalisation (profile-c14n/2) et la génération de politique. La règle N/N−1 et SemVer-dès-0.x de cluster-mesh s’applique aux frontières d’intégration. Les majeurs de schéma inconnus sont refusés ou conservés comme non validés selon le contrat F1, jamais interprétés comme faits validés. Un hachage non cryptographique de mise en page (FNV) ne sert jamais de preuve d’intégrité ou d’autorisation (empreinte SHA-256 requise).":"The contract distinguishes package SemVer, document schema major version, ontology profile version, canonicalization version (profile-c14n/2), and policy generation. cluster-mesh’s N/N−1 and SemVer-from-0.x rules apply at integration boundaries. Unknown schema major versions are rejected or retained as unvalidated under contract F1; they are never interpreted as validated facts. A non-cryptographic layout hash (FNV) never proves integrity or authorisation; a SHA-256 fingerprint is required.","Manifestes CanonicalManifest (@sentropic/artifacts 0.1.1), architectureHash et SHA256SUMS.":"CanonicalManifest manifests (@sentropic/artifacts 0.1.1), architectureHash and SHA256SUMS.","Identité vérifiée, périmètre d’espace de travail et second facteur 2FA":"Verified identity, workspace scope and two-factor authentication","sentropic · h2a":"Sentropic · h2a",'Chaque hôte lie l’identité authentifiée (humain ou identité non-humaine NHI DEC-114), le tenantId, le workspaceId, l’espace d’isolation (namespace), la finalité (purpose_ref) et la politique effective à l’opération. Il est interdit d’assimiler par homonymie workspaceId, tenantId, namespace Hono, namespace de ressource, schéma SQL Postgres et namespace Kubernetes. Lecture, écriture, délivrance à un agent, action sur un appareil Cowork, export et élévation 2FA (amr: "mfa" #695) sont vérifiés séparément.':'Every host binds the authenticated identity (human or non-human identity, NHI DEC-114), tenantId, workspaceId, isolation namespace, purpose_ref and effective policy to the operation. workspaceId, tenantId, Hono namespace, resource namespace, Postgres SQL schema and Kubernetes namespace must never be equated merely because they share a name. Reading, writing, delivery to an agent, acting on a Cowork device, export and 2FA elevation (amr: "mfa" #695) are checked separately.',"session-resolver.ts, workspace-scope-guard et vérification indépendante des permissions.":"session-resolver.ts, workspace-scope-guard and independent permission checks.","Circuit de revue contradictoire indépendante et plafond de 3 tours":"Independent adversarial review and a three-round limit","h2a · engram · sentropic · design-system":"h2a · Engram · Sentropic · Design System","Toute conception ou modification inter-projets requiert les propriétaires des domaines touchés et une revue contradictoire indépendante de la frontière partagée (l’auteur du build ne compte jamais comme relecteur). Les exigences locales plus fortes (≥ 2 pairs indépendants dans h2a, circuit spec Engram avec co-gel) sont préservées. Un défaut récurrent au tour 2 exige une note de conception écrite avant nouveau build ; au plafond de 3 tours, bascule d’auteur ou escalade d’options au propriétaire.":"Every cross-project design or change requires the affected domain owners and an independent adversarial review of the shared boundary; the build author never counts as a reviewer. Stronger local requirements remain in force: at least two independent h2a peers, and the Engram specification process with a joint freeze. A recurring defect in round two requires a written design note before rebuilding. At the three-round limit, change the author or escalate options to the owner.","Journaux de revue multi-pairs et suivi des tours dans Track.":"Multi-peer review logs and round tracking in Track.","Résolution des conflits et escalade bornée au propriétaire":"Conflict resolution and bounded escalation to the owner","Propriétaires de registres · arch · propriétaire":"Record owners · arch · owner","Tout litige est d’abord classé : fait erroné, contrat ambigu, désaccord de politique, conflit de priorité ou conflit d’autorité. Le propriétaire du registre tranche une correction factuelle sur preuve ; le mainteneur du domaine tranche une implémentation locale compatible ; les co-propriétaires réconcilient une frontière partagée avec avis obligatoire d’arch. Tant que le conflit n’est pas résolu, la dernière version qualifiée reste active. Seul un choix matériel non résolu est escaladé au propriétaire (escalate-not-resolve) via un dossier Focus.":"Classify every dispute first: incorrect fact, ambiguous contract, policy disagreement, priority conflict or authority conflict. The record owner settles a factual correction using evidence; the domain maintainer decides a compatible local implementation; co-owners reconcile a shared boundary with mandatory input from arch. Until the conflict is resolved, the latest qualified version stays active. Only an unresolved material choice is escalated to the owner (escalate-not-resolve) through a Focus dossier.","Présence d’options distinctes, de leurs conséquences et de leur réversibilité dans chaque dossier Focus.":"Every Focus dossier includes distinct options, consequences and reversibility.","Résultats d’exécution, observabilité et réconciliation des opérations incertaines":"Execution outcomes, observability and reconciliation of uncertain operations","Chaque hôte d’exécution · sentropic · h2a":"Each execution host · Sentropic · h2a","Chaque opération distingue l’entrée soumise, le travail engagé, l’écriture durable (commise), la visibilité publiée et le résultat accepté (surface-invariants.md:63). Elle enregistre les clés auditId/correlationId et d’idempotence ainsi que le reçu durable. Une expiration de délai (timeout) à l’issue incertaine déclenche obligatoirement une procédure de réconciliation d’état, jamais un succès inventé ni un rejeu aveugle. Fusion Git, publication npm, installation et acceptation propriétaire sont séparées ; un état jamais qualifié s’affiche « non qualifié » sans couleur.":"Each operation distinguishes submitted input, engaged work, durable committed writes, published visibility and the accepted result (surface-invariants.md:63). It records auditId/correlationId, idempotency keys and a durable receipt. A timeout with an uncertain outcome must trigger state reconciliation, never an invented success or a blind replay. Git merge, npm publication, installation and owner acceptance remain separate. A state never qualified is displayed as “unqualified” without a colour.","Corrélation auditId de bout en bout et séparation des états dans Track et cluster-mesh.":"End-to-end auditId correlation and separate states in Track and cluster-mesh.","Transfert durable d’obligation et règles de dépréciation":"Durable transfer of obligations and deprecation rules","Dépôt cédant × dépôt récepteur":"Transferring repository × receiving repository","Tout transfert de responsabilité ou d’item nomme le contrat/item source, le rôle et le dépôt récepteur responsable, l’identifiant de destination accepté, les liens réciproques, l’obligation de sortie/retour arrière (rollback) et l’acceptation consommateur restante. L’ancien propriétaire reste responsable jusqu’à l’acquittement explicite du récepteur. Publier un paquet en amont ne clôt jamais l’obligation d’adoption aval (les 8 sujets du dossier ds-history conservent leurs dispositions distinctes).":"Every transfer of responsibility or an item names the source contract/item, responsible receiving role and repository, accepted destination identifier, reciprocal links, exit/rollback obligation and remaining consumer acceptance. The former owner remains accountable until the receiver explicitly acknowledges the transfer. Publishing an upstream package never closes the downstream adoption obligation; the eight topics in the ds-history dossier retain their separate dispositions.","Preuve d’acquittement bidirectionnel dans Track avant toute dépréciation ou clôture.":"Bidirectional acknowledgement evidence in Track before any deprecation or closure.","Cycle de vie de la mémoire agentique (D3/D10) et étanchéité des exports Git":"Agentic memory lifecycle (D3/D10) and isolation of Git exports","engram · sentropic (#684 / #685 / L5)":"Engram · Sentropic (#684 / #685 / L5)","La mémoire agentique est gouvernée exclusivement par le journal canonique D3 et l’état d’autorisation courant via les 6 outils MCP gelés v3.2 (src/mcp/memory/contracts.ts:142). La projection filtrée D10 (.engram/graph.json), l’indexation Git engram-live et les exports ne créent aucune voie d’admission parallèle. Le retrait ou l’oubli (tombstone) purge les stockages (X2/X2b) et les tests de restauration (#372 X4) prouvent qu’aucune sauvegarde ne ressuscite un souvenir oublié. Aucun identifiant, empreinte ou arête mémoire (MemoryRef) n’est commité dans les exports Git (knowledge/*). Engram doit consommer de façon agnostique l’interface DB neutre de cluster-mesh (C-02) : il déclare la surface par besoin — transactionnel pour le journal canonique D3, analytique pour les références de temps D1=C, graphe live pour les faits Git et la projection filtrée D10 — sans choisir de backend et sans pilote DB natif dans sa fermeture de dépendances. E2/L5 doit qualifier la surface transactionnelle sur SQLite d’abord (image Node 24), puis Postgres ; les surfaces analytique et graphe live restent à qualifier séparément.":"Agentic memory is governed exclusively by the canonical D3 log and current authorisation state through the six frozen MCP tools v3.2 (src/mcp/memory/contracts.ts:142). The filtered D10 projection (.engram/graph.json), engram-live Git indexing and exports create no parallel admission route. Withdrawal or forgetting (tombstone) purges storage (X2/X2b); restoration tests (#372 X4) prove that no backup resurrects a forgotten memory. No memory identifier, fingerprint or edge (MemoryRef) is committed to Git exports (knowledge/*). Engram must consume cluster-mesh’s neutral DB interface agnostically (C-02), declaring a surface per need: transactional for the canonical D3 log, analytical for D1=C time references, and live graph for Git facts and the filtered D10 projection. It chooses no backend and includes no native DB driver in its dependency closure. E2/L5 must qualify transactions on SQLite first (Node 24 image), then Postgres; analytical and live graph surfaces still need separate qualification.","Qualifications #685 → E2/L5 (#697) : reçus transactionnels SQLite (Node 24), puis Postgres ; audit de la fermeture de dépendances sans pilote DB natif ; tests X2/X2b/X4, absence de MemoryRef dans Git et preuves propres aux deux autres surfaces.":"Qualifications #685 → E2/L5 (#697): SQLite (Node 24) transactional receipts, then Postgres; audit of a dependency closure without native DB drivers; X2/X2b/X4 tests; no MemoryRef in Git; separate evidence for the other two surfaces.","Références de temps (D1=C + agent-stats) et garde de planification":"Time references (D1=C + agent-stats) and planning safeguards","engram (D1=C) · h2a (WP8 & agent-stats) · sentropic (#698)":"Engram (D1=C) · h2a (WP8 and agent-stats) · Sentropic (#698)","Conformément au choix D1 = C, Engram est le service central des références de temps ; les exports typés commités (knowledge/manifest.json, ci/timings.json, ci/graph.json, architecture/graph.json) déclarent leur version source, les 4 horloges (exécution, collecte, publication, applicabilité), l’empreinte du régime de configuration et la version de l’estimateur. Les estimations (en heures d’agent et tours de revue via D1=C et agent-stats sur 7 jours glissants par défaut) distinguent valeurs mesurées, intervalles modélisés et statuts incomplete/unknown ; une prévision temporelle n’autorise jamais à sauter une porte de qualification.":"Under decision D1=C, Engram is the central time reference service. Committed typed exports (knowledge/manifest.json, ci/timings.json, ci/graph.json, architecture/graph.json) declare their source version, four clocks (execution, collection, publication, applicability), configuration-regime fingerprint and estimator version. Estimates, expressed in agent hours and review rounds through D1=C and agent-stats over a rolling seven-day window by default, distinguish measured values, modelled intervals and incomplete/unknown states. A time forecast never authorises skipping a qualification gate.","Schémas d’export repo-knowledge@1 et séparation entre prévision et preuve de livraison.":"repo-knowledge@1 export schemas and a distinction between forecasts and delivery evidence.","Critères d’acceptation du contrat unifié sur 4 routes verticales réelles":"Unified-contract acceptance on four real vertical routes","La mise en œuvre du contrat unifié est qualifiée bout-en-bout sur quatre routes verticales réelles : (1) la route d’annotation (surcouche annotate → persistance comments avec namespace et 2FA → délivrance à l’agent h2a), (2) la route de mémoire autorisée (search/capture/admit/forget via cluster-mesh selon l’ordre #685 → L5 → R2/R7a/R3), (3) la route de diagramme adossée à un profil d’ontologie figé d’Engram et rendue par le Design System, et (4) une trace complète en 7 sauts de la demande à la production.":"The unified contract is qualified end to end on four real vertical routes: (1) annotation, from the annotate overlay through comments persistence with namespace and 2FA to delivery to the h2a agent; (2) authorised memory, through search/capture/admit/forget via cluster-mesh in the order #685 → L5 → R2/R7a/R3; (3) a diagram backed by a frozen Engram ontology profile and rendered by Design System; and (4) a complete seven-hop trace from request to production.","Preuves d’exécution réelles des jalons M1 à M5.":"Real execution evidence for milestones M1–M5.","Un seul modèle de données (annotation) + un outil (annotate) sur les canvas du catalogue/MCP":"One data model (annotation) and one tool (annotate) on catalogue/MCP canvases","Arbitrage propriétaire post-R3 (OWNER-REQUEST.md:13-17) · sentropic · design-system · h2a · engram":"Owner’s post-R3 decision (OWNER-REQUEST.md:13-17) · Sentropic · Design System · h2a · Engram","Diagrammes gigognes, algorithmes dans notre JS, éditions atomiques et mode 100 % offline sans CDN":"Nested diagrams, algorithms in our JS, atomic edits and fully offline operation without a CDN","Arbitrages verbatim du propriétaire sur les diagrammes (via h-cond)":"Owner’s verbatim diagram decisions (via h-cond)","Application directe des trois arbitrages propriétaire : (1) algorithmes ouverts/publics (placement en couches, routage orthogonal, couverture ELK planifiée) implémentés dans nos propres souches JS ; (2) diagrammes gigognes ouvrables où tout diagramme est un graphe et toute représentation une synthèse séparant modèle de graphe (SemanticDocument / GraphModel [PROPOSAL]), mise en page (ViewDocument / DiagramLayout) et skill de présentation (PresentationSkill) ; (3) priorité à la réactivité et à l’atomicité des éditions ainsi qu’au fonctionnement 100 % offline sans CDN (l’embarquement autonome du JS, y compris ~32 Mo, étant accepté par le propriétaire pour garantir le mode offline).":"Apply the owner’s three decisions directly: (1) open/public algorithms (layered placement, orthogonal routing, planned ELK coverage) implemented in our own JS foundations; (2) expandable nested diagrams, where every diagram is a graph and every representation is a synthesis separating the graph model (SemanticDocument / GraphModel [PROPOSAL]), layout (ViewDocument / DiagramLayout) and presentation skill (PresentationSkill); (3) priority for responsiveness, atomic edits and fully offline operation without a CDN. The owner accepts self-contained JS embedding, including roughly 32 MB, to guarantee offline operation.","Gouvernance des identités non humaines (NHI1..NHI9)":"Non-human identity governance (NHI1..NHI9)","h2a · sentropic (auth-idp)":"h2a · Sentropic (auth-idp)","Tout agent, connecteur, service ou jeton automatisé est rattaché à un responsable humain identifié, un mandat borné, une durée de vie finie et une procédure de révocation et d’offboarding vérifiable (h2a_nhi_* dans h2a et packages/auth-idp/src/nhi.ts dans sentropic). Aucun secret ni jeton NHI n’est partagé implicitement entre espaces de travail.":"Every agent, connector, service or automated token is linked to an identified human owner, a bounded mandate, a finite lifetime and a verifiable revocation and offboarding process (h2a_nhi_* in h2a and packages/auth-idp/src/nhi.ts in Sentropic). No NHI secret or token is implicitly shared between workspaces.","Registre NHI h2a_nhi_inventory / h2a_nhi_offboard et contrôle auth-idp/src/nhi.ts.":"h2a_nhi_inventory / h2a_nhi_offboard registry and auth-idp/src/nhi.ts checks.","Consentement explicite par action sur poste utilisateur (Cowork)":"Explicit consent per action on a user workstation (Cowork)","sentropic (cowork-bridge / cowork-desktop) · h2a (drive.instruction)":"Sentropic (cowork-bridge / cowork-desktop) · h2a (drive.instruction)","Les surfaces cowork-desktop et cowork-bridge appliquent le même contrat d’identité et de catalogue que CLI et Cloud, enrichi d’un consentement explicite de l’utilisateur par action (drive.instruction, h2a_drive_consent_*) et d’une fenêtre d’exclusion prioritaire de 60 secondes dès qu’une activité locale humaine est détectée.":"cowork-desktop and cowork-bridge apply the same identity and catalogue contract as CLI and Cloud, with explicit user consent per action (drive.instruction, h2a_drive_consent_*) and a 60-second priority exclusion window whenever local human activity is detected.","Contrôles de présence appareil cowork-bridge/desktop et révocation immédiate sur activité locale humaine (60 s).":"cowork-bridge/desktop device presence checks and immediate revocation upon local human activity (60 s).","Glossaire opérationnel et séparation des 4 systèmes de référence":"Operational glossary and separation of the four systems of record","Ce dossier place le diagramme d’architecture au cœur du contrat long terme entre les quatre projets (h2a, engram, sentropic, design-system). Lorsqu’un humain ou un agent exprime un besoin concret (« annoter un écran », « conserver une annotation », « suivre une demande jusqu’en production », « estimer un lot »), le sélecteur ci-dessus illumine la route correspondante sur le diagramme central, identifie l’unique dépôt responsable principal proposé et distingue les projets contributeurs.":"This dossier puts the architecture diagram at the centre of the long-term contract between four projects: h2a, Engram, Sentropic and Design System. When a human or agent expresses a concrete need—annotating a screen, keeping an annotation, following a request to production, or estimating a workpackage—the selector above highlights the corresponding central-diagram route, identifies one proposed accountable repository and distinguishes contributing projects.","Pour permettre une lecture directe sans jargon d’implémentation, la table ci-dessous précise à la fois la responsabilité exclusive de chaque dépôt et le sens opérationnel des termes utilisés dans les cartes de routage (les 4 axes de disponibilité, la garde des sièges, les empreintes SHA-256, les 7 sauts de traçabilité et le couloir prioritaire « Mémoire d’abord »).":"The table below explains each repository’s exclusive responsibility and the operational meaning of route-card terminology: four availability axes, seat custody, SHA-256 fingerprints, seven traceability hops and the priority Memory First sequence.","Système ou terme opérationnel":"System or operational term","Responsable principal":"Accountable owner","Signification concrète pour le propriétaire":"Concrete meaning for the owner","Garde-fou & frontière à ne pas franchir":"Safeguard and boundary that must not be crossed","1. h2a · Organisation IA responsable · Track & Focus":"1. h2a · Responsible AI Organization · Track and Focus","Définit qui a le droit d’agir (rôles, mandats, identités d’agents NHI), suit les demandes rattachées à un lot de travail (WP) dans le journal .track/events.jsonl et présente les choix d’architecture dans Focus.":"Defines who may act (roles, mandates, NHI agent identities), follows requests attached to a workpackage (WP) in .track/events.jsonl, and presents architecture choices in Focus.","Ne stocke ni la mémoire sémantique des agents (déléguée à engram), ni les bases de données applicatives ou les secrets (délégués à sentropic).":"Stores neither agents’ semantic memory, delegated to Engram, nor application databases or secrets, delegated to Sentropic.","2. engram · Mémoire agentique, ontologies (WP9) & temps (D1=C)":"2. Engram · Agentic memory, ontologies (WP9) and time (D1=C)","Garde le journal officiel des souvenirs admis (D3) et son graphe filtré à l’oubli (D10), valide toutes les ontologies en anglais (lot WP9) et calcule les références de temps mesurées (choix D1=C).":"Guards the authoritative log of admitted memories (D3) and its forgetting-filtered graph (D10), validates English ontologies (WP9), and computes measured time references (decision D1=C).","Ne prend aucune décision de gouvernance à la place de h2a et n’exporte jamais d’identifiant de souvenir privé (MemoryRef) dans les fichiers Git.":"Makes no governance decisions on h2a’s behalf and never exports private memory identifiers (MemoryRef) into Git files.","3. sentropic · Plateforme agentique":"3. Sentropic · Agentic Platform","Expose les services par API ; porte workflows, catalogue logique (MCP, IA, ressources, UI/canvas/apps), sécurité et observabilité, stockage des modèles et artefacts. Cluster intègre exclusivement les instances Sentropic entre elles. Le même cadre Intégration contient les services providers : cloud (K8s, mails transactionnels), App Store et registres applicatifs, d’agents et de MCP. Le stockage porte l’interface DB neutre et trois surfaces optimisées (transactionnel, analytique, graphe live), avec SQLite et Postgres prioritaires ; cible à qualifier distincte du constat Postgres/S3 #684. Le catalogue MCP inclut le harnais (outils h2a dont annotate, modèle annotation via comments), les outils mémoire/ontologies et les connecteurs à broker ; le catalogue UI inclut bpmn-canvas et le templater Sentropic. Les familles demandées restent distinctes de leur statut de livraison.":"Exposes services through APIs and owns workflows, the logical catalogue (MCP, AI, resources, UI/canvas/apps), security and observability, and model and artifact storage. Cluster integrates Sentropic instances with one another. The same Integration frame contains provider services: cloud (K8s, transactional email), App Store, and application, agent and MCP registries. Storage owns the neutral DB interface and three optimised surfaces—transactional, analytical and live graph—with SQLite and Postgres first. This target requires qualification separately from observed Postgres/S3 #684 evidence. The MCP catalogue includes the harness (h2a tools including annotate; annotation model through comments), memory/ontology tools and connectors to broker. The UI catalogue includes bpmn-canvas and the Sentropic templater. Requested families remain distinct from their delivery status.","N’invente pas de second modèle de mémoire ou de suivi de tâches, et n’active aucun connecteur sans autorisation vérifiée.":"Creates no second memory or task-tracking model, and activates no connector without verified authorisation.","4. Design System · Annotations, diagramme, dossier de décision et 200+ composants UI":"4. Design System · Annotations, diagrams, decision dossiers and 200+ UI components","Porte les quatre responsabilités visuelles : annotations/annotate, graphe × layout × présentation, rendu des dossiers Focus, composants et thèmes. Le schéma et la skill Focus restent dans h2a ; le modèle annotation est exposé par comments MCP et sérialisé dans le stockage.":"Owns four visual responsibilities: annotations/annotate, graph × layout × presentation, Focus dossier rendering, and components and themes. The Focus schema and skill stay in h2a; the annotation model is exposed by comments MCP and serialized in storage.","Aucune logique métier d’application, aucun accès direct aux bases de données et aucun appel réseau vers un CDN externe.":"No application business logic, direct database access or network calls to an external CDN.","5. Termes de disponibilité (Décision / Code / Publication / Hôte)":"5. Availability terminology (Decision / Code / Publication / Host)","Gouvernance commune":"Shared governance","Évite toute confusion entre une orientation d’architecture, un code fusionné, un paquet publié sur npm et un service réellement actif en production.":"Prevents confusion between an architecture direction, merged code, an npm package and a service actually running in production.","6. Termes clés : Garde des sièges, Empreinte SHA-256, 7 sauts & Couloir mémoire":"6. Key terms: seat custody, SHA-256 fingerprint, seven hops and memory priority","« Garde des sièges » = coffre central chiffré des abonnements CLI/LLM (#596). « Empreinte SHA-256 » = sceau cryptographique garantissant qu’un fichier ou contrat n’a pas changé. « 7 sauts » = chaîne reliant une demande initiale jusqu’à l’acceptation en production. « #685 → L5 → R2/R7a/R3 » = obligation de qualifier la mémoire (M1) avant d’ouvrir le catalogue (M2).":"Seat custody means a central encrypted vault for CLI/LLM subscriptions (#596). A SHA-256 fingerprint is a cryptographic seal proving a file or contract has not changed. Seven hops means the chain from the initial request to production acceptance. #685 → L5 → R2/R7a/R3 requires qualifying memory (M1) before opening the catalogue (M2).","En r1, les 5 vues SVG de ce dossier sont une maquette statique d’étude ; le moteur dynamique partagé (@sentropic/diagram-kernel [PROPOSAL] : GraphModel + DiagramLayout + PresentationSkill) sera raccordé en M4.":"In r1, this dossier’s five SVG views are a static study mockup. The shared dynamic engine (@sentropic/diagram-kernel [PROPOSAL]: GraphModel + DiagramLayout + PresentationSkill) is to be integrated at M4.","Croquis, positions des projets et dernier retour propriétaire":"Sketch, project positions and latest owner feedback","Élément du croquis / arbitrage":"Sketch element or decision","Observation dans les sources propriétaire & h2a.md":"Observation in owner sources and h2a.md","Traduction architecturale dans le contrat d’unification":"Architectural meaning in the unification contract","Ancrage dans le kit Focus":"Anchor in the Focus kit","Accès · croquis complété par le retour du propriétaire":"Access · sketch completed by owner feedback","Le dernier retour ajoute ChatGPT, Gemini, Claude et Muse, avec les liaisons Cowork/MCP, aux accès CLI, Cowork et Cloud.":"The latest feedback adds ChatGPT, Gemini, Claude and Muse, with Cowork/MCP connections, alongside CLI, Cowork and Cloud access.","Chaque surface rejoint la façade serveur API. La qualification de chaque liaison fournisseur reste explicite ; aucun accès n’impose de transiter par les autres surfaces.":"Each access surface connects to the server API façade. Qualification of each provider connection stays explicit; no access requires going through the other surfaces.","Scène architecture.central · groupes h2a et surfaces":"Scene architecture.central · h2a and surfaces groups","Croquis propriétaire · Connexions Engram ↔ Catalogue & ajouts proposés":"Owner sketch · Engram ↔ Catalogue connections and proposed additions","Sur le croquis, les branches ontologies (dev, track, archi) et memory du bloc catalogues descendent directement vers engram (ontologies et live, mem, agents).":"In the sketch, the catalogs block’s ontologies (dev, track, archi) and memory branches connect directly down to Engram (ontologies and live, mem, agents).","Engram déclare ses contrats mémoire et ontologies dans le catalogue MCP (mcp-tools sous cat-mcp), fournit les profils à ds-diagram et consomme l’interface de sérialisation DB neutre de cluster-mesh. Il déclare une surface (D3 transactionnel, D1=C analytique, Git/D10 graphe live) sans choisir de backend ni embarquer de pilote DB natif ; son autorité D3/D10 reste inchangée. E2/L5 doit qualifier le transactionnel sur SQLite (Node 24), puis Postgres.":"Engram declares its memory and ontology contracts in the MCP catalogue (mcp-tools under cat-mcp), supplies profiles to ds-diagram and consumes cluster-mesh’s neutral DB serialization interface. It declares a surface—D3 transactional, D1=C analytical, Git/D10 live graph—without choosing a backend or bundling a native DB driver. Its D3/D10 authority stays unchanged. E2/L5 must qualify transactions on SQLite (Node 24), then Postgres.","Scène architecture.central · flèches e-eng-mem, e-eng-onto, e-eng-ds et intra-mesh":"Scene architecture.central · e-eng-mem, e-eng-onto, e-eng-ds and intra-mesh arrows","Carte initiale h2a.md vs Croquis propriétaire":"Initial h2a.md map versus owner sketch","Dans h2a.md [PROPOSAL], la carte Mermaid trace h2a → CLI/cowork/cloud → Catalogue sentropic → {Track, Engram, Focus} → Design system (avec Engram ---|profils versionnés| DS).":"In h2a.md [PROPOSAL], the Mermaid map traces h2a → CLI/cowork/cloud → Sentropic Catalogue → {Track, Engram, Focus} → Design System, with Engram supplying versioned profiles to Design System.","Réconciliation : h2a détient la paternité sémantique et les journaux de Track et Focus (comme sur le croquis), tandis que le catalogue cluster-mesh de sentropic expose leurs capacités et contrats.":"Reconciliation: h2a owns Track and Focus semantics and logs, as in the sketch, while Sentropic’s cluster-mesh catalogue exposes their capabilities and contracts.","Scène architecture.central · e-api-mcp, e-apis-wf et e-mesh-h2a":"Scene architecture.central · e-api-mcp, e-apis-wf and e-mesh-h2a","Arbitrage verbatim h-cond #1 · Algorithmes publics dans notre JS":"Verbatim h-cond decision #1 · Public algorithms in our JS","« Les algo open licence libre ou algo public mais dans notre js a nous … On respect mais on libere au max et on a nos propres souches ».":"« Les algo open licence libre ou algo public mais dans notre js a nous … On respect mais on libere au max et on a nos propres souches ».","Implémentation dans nos propres souches JS/TS des algorithmes de mise en page en couches, de routage orthogonal et de la couverture ELK planifiée (@sentropic/diagram-canvas L8 / @sentropic/diagram-kernel [PROPOSAL]).":"Implement layered layout, orthogonal routing and planned ELK coverage in our own JS/TS foundations (@sentropic/diagram-canvas L8 / @sentropic/diagram-kernel [PROPOSAL]).","Clause C-16 · Décision G2 · Vue d’étude architecture.ontologies":"Clause C-16 · Decision G2 · Study view architecture.ontologies","Arbitrage verbatim h-cond #2 · Diagrammes gigognes ouvrables":"Verbatim h-cond decision #2 · Expandable nested diagrams","« diagrammes gigogne (ouvrables) … Tout diagramme est un graph et toute representation est une forme de synthese. Il faut bie modeliser diagramme layout et skills de presentation ».":"« diagrammes gigogne (ouvrables) … Tout diagramme est un graph et toute representation est une forme de synthese. Il faut bie modeliser diagramme layout et skills de presentation ».","Séparation formelle en 3 couches : SemanticDocument / GraphModel [PROPOSAL] (nœuds composites ouvrables), ViewDocument / DiagramLayout (géométrie sans coordonnées auteur dans Focus) et PresentationSkill.":"Formal separation into three layers: SemanticDocument / GraphModel [PROPOSAL] with expandable composite nodes; ViewDocument / DiagramLayout with geometry and no author coordinates in Focus; and PresentationSkill.","Clause C-16 · Maquette d’étude à 5 vues [data-gigogne-id] (moteur partagé en M4)":"Clause C-16 · Five-view study mockup [data-gigogne-id], with the shared engine at M4","Arbitrage verbatim h-cond #3 · Réactivité, atomicité et mode offline sans CDN":"Verbatim h-cond decision #3 · Responsiveness, atomicity and offline operation without a CDN","« L enjeu n est pas la taille mais la reactivité et l atomicité des editions … la acapacite offline sans cdn doit etre possible donc ok la 32Mo qd js embedb ».":"« L enjeu n est pas la taille mais la reactivité et l atomicité des editions … la acapacite offline sans cdn doit etre possible donc ok la 32Mo qd js embedb ».","Priorité à la réactivité et aux transactions atomiques d’édition ainsi qu’au fonctionnement 100 % hors-ligne sans CDN (l’embarquement autonome du JS, tel qu’un bundle de 32 Mo, étant accepté sans constituer un plafond inventé).":"Prioritise responsive, atomic editing transactions and fully offline operation without a CDN. Self-contained JS embedding, such as a 32 MB bundle, is accepted; that example is not an invented size limit.","Clause C-16 · Fichier HTML portable autonome sans CDN":"Clause C-16 · Self-contained portable HTML without a CDN","Arbitrage verbatim post-R3 (OWNER-REQUEST.md:13-17) · Canvas au catalogue/MCP sur artifacts/UI prod & modèle unique annotation + outil annotate":"Verbatim post-R3 decision (OWNER-REQUEST.md:13-17) · Canvases in the catalogue/MCP on artifacts/production UI, with one annotation model and the annotate tool","« Question très mal posée. Les canvas (ui+interaction ia) doivent être dans le catalogue, exposé avec un mcp, hosté par dessus artefact et potentiellement ui en prod. Mais j'imagine que le modèle d'annotation doit être annotation + annotate j'imagine un modèle de donnée. A voir où tu gères la mise en catalog et mcp ».":"« Question très mal posée. Les canvas (ui+interaction ia) doivent être dans le catalogue, exposé avec un mcp, hosté par dessus artefact et potentiellement ui en prod. Mais j'imagine que le modèle d'annotation doit être annotation + annotate j'imagine un modèle de donnée. A voir où tu gères la mise en catalog et mcp ».",'Les canvas (UI + interaction IA) sont des entrées du catalogue (kind="canvas"), exposées via un serveur MCP, hébergées par-dessus @sentropic/artifacts (0.1.1) et potentiellement servies comme UI en prod ; l’annotation repose sur un seul modèle de données (annotation dans @sentropic/comments) couplé à l’outil de capture (annotate) ; la mise en catalogue et le registre MCP résident dans sentropic (cluster-mesh).':'Canvases (UI + AI interaction) are catalogue entries (kind="canvas"), exposed through an MCP server, hosted on @sentropic/artifacts (0.1.1) and potentially served as production UI. Annotation uses one data model, annotation in @sentropic/comments, paired with the annotate capture tool. Catalogue and MCP registry management reside in Sentropic (cluster-mesh).',"Clauses C-04 & C-15 · Décision G3 · Vue d’étude architecture.annotate":"Clauses C-04 and C-15 · Decision G3 · Study view architecture.annotate","Architecture unifiée suite à l’arbitrage propriétaire post-R3 : canvas (UI + interaction IA au catalogue, MCP, sur artifacts et UI prod), modèle de données unique « annotation » + outil « annotate », et emplacement de la mise en catalogue et du MCP":"Unified architecture after the owner’s post-R3 decision: canvases (UI + AI interaction in the catalogue, MCP, artifacts and production UI), one annotation data model and the annotate tool, and ownership of catalogue and MCP registration","Brique architecturale":"Architecture component","Nature exacte (arbitrage propriétaire post-R3)":"Exact nature under the owner’s post-R3 decision","Responsable principal & spécifications de référence":"Accountable owner and reference specifications","Chaîne d’exécution & d’exposition (Qui fait quoi)":"Execution and exposure chain: who does what","Persistance, hébergement & preuve":"Persistence, hosting and evidence","1. Canvas (UI + interaction IA) : entrée catalogue, exposition MCP, hébergement sur artifacts et UI en prod":"1. Canvas (UI + AI interaction): catalogue entry, MCP exposure, artifacts hosting and production UI","Surface interactive combinant rendu UI et interaction IA (Focus, diagrammes gigognes, BPMN, écrans d’application), inscrite au catalogue et exposée par MCP.":"An interactive surface combining UI rendering and AI interaction—Focus, nested diagrams, BPMN or application screens—listed in the catalogue and exposed through MCP.",'design-system (templates & composants <st-*>, diagram-canvas L8) · h2a (Focus & MCP ui:// H-4) · sentropic (catalogue kind="canvas", registre MCP & @sentropic/artifacts)':'Design System (templates and <st-*> components, diagram-canvas L8) · h2a (Focus and MCP ui:// H-4) · Sentropic (catalogue kind="canvas", MCP registry and @sentropic/artifacts)','1. Le template est inscrit comme kind="canvas" (api/src/services/catalog/types.ts:22,95 ; SPEC_EVOL_CATALOG.md:99,150 ; SPEC_EVOL_APP_CATALOG.md:5,29,46) → 2. Son serveur MCP est enregistré dans cluster-mesh (SPEC_EVOL_CLUSTER_MESH_MCP_REGISTRY_ARTIFACTS.md:101,109,135 #679/#692 ; Option E H-4 SPEC_EVOL_DS_JSON_RENDER_STANDARD.md:71,102) → 3. Il est hébergé par-dessus @sentropic/artifacts (0.1.1) et potentiellement monté directement comme UI en production.':'1. Register the template as kind="canvas" (api/src/services/catalog/types.ts:22,95; SPEC_EVOL_CATALOG.md:99,150; SPEC_EVOL_APP_CATALOG.md:5,29,46) → 2. Register its MCP server in cluster-mesh (SPEC_EVOL_CLUSTER_MESH_MCP_REGISTRY_ARTIFACTS.md:101,109,135 #679/#692; Option E H-4 SPEC_EVOL_DS_JSON_RENDER_STANDARD.md:71,102) → 3. Host it on @sentropic/artifacts (0.1.1), potentially mounted directly as production UI.',"Manifeste CanonicalManifest SHA-256 (@sentropic/artifacts 0.1.1, origines isolées <artifactId>.<base> / <releaseId>.pinned.<base>) + rendu UI prod":"CanonicalManifest SHA-256 manifest (@sentropic/artifacts 0.1.1, isolated origins <artifactId>.<base> / <releaseId>.pinned.<base>) and production UI rendering","2. Outil « annotate » (outil de capture UI + interaction IA / MCP)":"2. annotate tool: UI capture and AI / MCP interaction","Outil d’interaction visuelle et MCP permettant de sélectionner une ancre sur tout canvas ou écran de production et de créer/mettre à jour une entrée dans le modèle de données unique annotation.":"A visual-interaction and MCP tool that selects an anchor on any canvas or production screen and creates or updates a record in the single annotation data model.","1. L’hôte ou le canvas active l’outil annotate (primitives visuelles DS + AnchorResolver) → 2. L’outil capture l’ancre typée (sélecteur DOM/SVG, nœud/arête SemanticDocument ou bloc Focus) et l’intention → 3. Appelle l’API/MCP de persistance sans jamais utiliser le CommentStore mémoire local de diag comme stockage de production.":"1. The host or canvas activates annotate (Design System visual primitives and AnchorResolver) → 2. The tool captures the typed anchor (DOM/SVG selector, SemanticDocument node/edge or Focus block) and intent → 3. It calls the persistence API/MCP, never using diag’s local in-memory CommentStore as production storage.","État de saisie UI éphémère (Plan D) ; écriture déléguée au modèle de données unique annotation (@sentropic/comments)":"Ephemeral UI input state (Plane D); writes delegated to the single annotation data model (@sentropic/comments)","3. Modèle de données unique « annotation » (persistance durable, ancres typées & révisions immuables)":"3. Single annotation data model: durable persistence, typed anchors and immutable revisions","Unique modèle de données durable d’annotation pour toutes les surfaces (écrans d’applications managées, canvas graphiques du Design System, dossiers Focus).":"One durable annotation data model for all surfaces: managed application screens, Design System graphical canvases and Focus dossiers.","sentropic (@sentropic/comments 0.3.0 : sentropic/packages/comments/src/anchors.ts:1,87, src/revisions.ts:1,29, stockage #684, 2FA #695)":"Sentropic (@sentropic/comments 0.3.0: sentropic/packages/comments/src/anchors.ts:1,87, src/revisions.ts:1,29, storage #684, 2FA #695)",'1. Sentropic vérifie la session et le 2FA (#695 amr: "mfa") → 2. Persiste l’enregistrement annotation sous la clé composite (tenantId, workspaceId, namespace, kind, id) avec révisions immuables et ancres structurées → 3. Résout l’agent destinataire depuis la table de confiance de l’hôte servi (threads/catalogue/synthesis.md:123,130) et livre à l’inbox h2a.':'1. Sentropic verifies the session and 2FA (#695 amr: "mfa") → 2. It persists the annotation record under the composite key (tenantId, workspaceId, namespace, kind, id), with immutable revisions and structured anchors → 3. It resolves the recipient agent using the served host’s trusted mapping (threads/catalogue/synthesis.md:123,130) and delivers to the h2a inbox.',"PostgreSQL Sentropic (#684, Plan C, règles DL-8/13/17) + reçu de délivrance corrélé (auditId) dans l’inbox h2a-agent":"Sentropic PostgreSQL (#684, Plane C, DL-8/13/17 rules) and a correlated delivery receipt (auditId) in the h2a-agent inbox","4. Emplacement proposé de la mise en catalogue et du MCP (références aux spécifications catalogue)":"4. Proposed ownership of catalogue and MCP registration, with catalogue specification references","Séparation entre la déclaration par chaque domaine producteur et la médiation centrale (catalogue logique + registre MCP synchrone + hébergement artifacts) dans sentropic.":"Separate each producer domain’s declaration from central mediation in Sentropic: logical catalogue, synchronous MCP registry and artifacts hosting.","Registre MCP synchrone (registry.ts:61) + projection CatalogSource.refresh() sans activation de fournisseur paresseux au lookup":"Synchronous MCP registry (registry.ts:61) and CatalogSource.refresh() projection, without activating a lazy provider during lookup","5. Promotions aval explicites : item de travail (@sentropic/track) et leçon admise (@sentropic/engram D3)":"5. Explicit downstream promotions: work item (@sentropic/track) and admitted lesson (@sentropic/engram D3)","Actes aval déclenchés à partir d’une annotation (et non modèles de données d’annotation concurrents).":"Downstream acts triggered from an annotation, with no competing annotation data models.","h2a (@sentropic/track, C02/C04) pour l’organisation et la décision · engram (journal canonique D3 & graphe D10, C05) pour la mémoire":"h2a (@sentropic/track, C02/C04) for organisation and decision · Engram (canonical D3 log and D10 graph, C05) for memory","1. Vers l’organisation et la décision : promotion explicite d’une annotation en événement Track (demand.raised / item.created dans .track/events.jsonl) pointant vers l’URI de l’annotation (résoudre le fil ne clôt jamais l’item Track). 2. Vers la mémoire : demande explicite memory_request_admission vers le journal D3 d’Engram avec ExternalRef (aucune promotion automatique d’une annotation en souvenir).":"1. Organisation and decision: explicitly promote an annotation into a Track event (demand.raised / item.created in .track/events.jsonl) pointing to its annotation URI. Resolving the thread never closes the Track item. 2. Memory: explicitly request memory_request_admission into Engram’s D3 log with ExternalRef. An annotation is never automatically promoted into a memory.","Journal append-only .track/events.jsonl (Plan A) et journal canonique D3 / graphe filtré D10 d’engram (Plan B)":"Append-only .track/events.jsonl log (Plane A) and Engram canonical D3 log / filtered D10 graph (Plane B)","Positions vérifiées [FACT/CODE], propositions [PROPOSAL] et écarts résiduels des 4 projets":"Verified positions [FACT/CODE], proposals [PROPOSAL] and remaining gaps across the four projects","Projet & révision épinglée":"Project and pinned revision","Faits vérifiés dans le code [FACT/CODE] et décisions actées [CONDUCTOR]":"Verified code facts [FACT/CODE] and settled decisions [CONDUCTOR]","Propositions d’architecture [PROPOSAL / SPEC]":"Architecture proposals [PROPOSAL / SPEC]","Écarts identifiés & décisions propriétaires correspondantes":"Identified gaps and corresponding owner decisions","h2a (h2a.md · H = 46b82b42 · inventory.md · DECISIONS-owner.md)":"h2a (h2a.md · H = 46b82b42 · inventory.md · DECISIONS-owner.md)","[CODE] Distingue acteurs, mandats et engagements CLI (packages/h2a/src/types.ts, VOCABULARY.md). Track porte demande brute → WP → items, RACI, décisions et preuves sur journal append-only .track/events.jsonl (MCP autonome en lecture seule). Focus publie packages/focus/registry/entries.v1.json. docs/governance/RACI.md est marqué en attente de ratification. [CONDUCTOR] Décisions actées (pas preuves de livraison) : WP obligatoire, défaut 7 jours glissants, « non qualifié » sans couleur, identifiants neutres + langue BCP 47, fusion et installation séparées.":"[CODE] Distinguishes actors, mandates and CLI commitments (packages/h2a/src/types.ts, VOCABULARY.md). Track owns raw request → WP → items, RACI, decisions and evidence in append-only .track/events.jsonl, with a standalone read-only MCP. Focus publishes packages/focus/registry/entries.v1.json. docs/governance/RACI.md is marked as awaiting ratification. [CONDUCTOR] Settled decisions, not delivery evidence: mandatory WPs, a rolling seven-day default, unqualified states without colour, neutral identifiers with BCP 47 display language, and separate merge and installation states.","[PROPOSAL] Conserver h2a pour coordination/mandats, Track pour faits d’organisation et de décision, harness pour méthode, Focus pour composition décisionnelle. Séparer conducteur, auteur, relecteur et contrôle. Articuler agent-stats (0.1.0) avec D1=C pour l’estimateur WP8 (prévision ≠ preuve de livraison).":"[PROPOSAL] Keep coordination and mandates in h2a, organisation and decision facts in Track, method in harness, and decision composition in Focus. Separate conductor, author, reviewer and control. Connect agent-stats (0.1.0) with D1=C for the WP8 estimator: forecast ≠ delivery evidence.","Couture visuelle h2a × design-system (h2a.md [FACT] · D = 25c0f3d3)":"Visual integration boundary: h2a × Design System (h2a.md [FACT] · D = 25c0f3d3)","[CODE] Focus porte le champ scene: SemanticDocument sans coordonnées auteur, mais packages/h2a/focus-kit/src/Canvas.svelte utilise encore un adaptateur provisoire sans appeler le moteur du Design System. Dans sent-tech-design-system (25c0f3d3), packages/components-svelte/src/lib/index.ts exporte 221 composants Svelte, et packages/diagram-core (0.1.0, SemanticDocument/ViewDocument/Transaction) ainsi que packages/diagram-canvas (layout L8) existent mais sont encore marqués private: true.":"[CODE] Focus carries scene: SemanticDocument without author coordinates, but packages/h2a/focus-kit/src/Canvas.svelte still uses a provisional adapter rather than the Design System engine. In sent-tech-design-system (25c0f3d3), packages/components-svelte/src/lib/index.ts exports 221 Svelte components. packages/diagram-core (0.1.0, SemanticDocument/ViewDocument/Transaction) and packages/diagram-canvas (layout L8) exist but remain marked private: true.","[PROPOSAL] Publier le moteur de diagrammes et converger vers l’architecture cible (@sentropic/diagram-kernel [PROPOSAL] : GraphModel gigogne ouvrable + DiagramLayout dans nos propres souches JS avec couverture ELK planifiée + PresentationSkill), réactive, atomique et 100 % offline sans CDN ; inscrire les canvas (UI + interaction IA) au catalogue, exposés en MCP et hébergés sur @sentropic/artifacts et potentiellement en UI prod.":"[PROPOSAL] Publish the diagram engine and converge on the target architecture (@sentropic/diagram-kernel [PROPOSAL]: expandable nested GraphModel + DiagramLayout in our own JS foundations with planned ELK coverage + PresentationSkill), with responsive, atomic, fully offline operation and no CDN. List canvases (UI + AI interaction) in the catalogue, exposed through MCP and hosted on @sentropic/artifacts, potentially as production UI.","engram (engram.md · E = a88375f0 · @sentropic/engram 0.20.0)":"Engram (engram.md · E = a88375f0 · @sentropic/engram 0.20.0)","[CODE] Journal mémoire canonique D3 (spec/SPEC_EVOL_AGENT_MEMORY_SUBSTRATE.md:11,73), graphe filtré à l’oubli D10 (#393), 6 outils MCP gelés v3.2 dans src/mcp/memory/contracts.ts:142, engram-live Git dans engram-live/ (engram-live/line-attribution.ts G1 #389, engram-live/symbol-history.ts G2 #390, L9 #391, L9-H #400), validation et fusion de profils dans src/ontology-profile.ts:69,188, src/profile-validate.ts:223 et src/merge-graphs.ts:1. [CONDUCTOR] Gardien de toutes les ontologies (WP9) et centre des références de temps (D1=C).":"[CODE] Canonical D3 memory log (spec/SPEC_EVOL_AGENT_MEMORY_SUBSTRATE.md:11,73), forgetting-filtered D10 graph (#393), six frozen MCP tools v3.2 in src/mcp/memory/contracts.ts:142, engram-live Git in engram-live/ (engram-live/line-attribution.ts G1 #389, engram-live/symbol-history.ts G2 #390, L9 #391, L9-H #400), profile validation and merging in src/ontology-profile.ts:69,188, src/profile-validate.ts:223 and src/merge-graphs.ts:1. [CONDUCTOR] Custodian of all ontologies (WP9) and central time reference service (D1=C).","[PROPOSAL / SPEC] Gouverner les profils d’ontologies 100 % anglais avec empreintes SHA-256 hors-ligne au build et outil MCP ontology_call au runtime ; publier les exports typés commités knowledge/* (repo-knowledge@1) sans aucun MemoryRef ; assembler des ContextPacks [PROPOSAL] signés.":"[PROPOSAL / SPEC] Govern fully English ontology profiles with offline build-time SHA-256 fingerprints and the runtime ontology_call MCP tool. Publish committed typed knowledge/* exports (repo-knowledge@1) without MemoryRef. Assemble signed ContextPacks [PROPOSAL].","sentropic (sentropic.md · S = 441453966 · cluster-mesh 0.18.0)":"Sentropic (sentropic.md · S = 441453966 · cluster-mesh 0.18.0)","[CODE] Implémentations inspectées avant le dernier retour : APIs serveur ; @sentropic/comments (0.3.0, anchors.ts, revisions.ts), sessions/workflows (WorkspaceBindingStore D1=A), catalogue dans api/src/services/catalog/types.ts:22 définissant 5 kinds implémentés (skill | tool | agent | workflow | canvas, #679) & registre MCP synchrone (deny-as-missing, createClusterMeshAppAdapter, createMcpAuth), sécurité IdP/2FA (session-resolver.ts, #695 sur branche), @sentropic/llm-mesh 0.26.1 (garde des sièges #596) & juge sur branche feat/llm-judge (030198a3), stockage (#684) & @sentropic/artifacts (0.1.1). Héberge @sentropic/harness.":"[CODE] Implementations inspected before the latest feedback: server APIs; @sentropic/comments (0.3.0, anchors.ts, revisions.ts); sessions/workflows (WorkspaceBindingStore D1=A); catalogue in api/src/services/catalog/types.ts:22 with five implemented kinds (skill | tool | agent | workflow | canvas, #679) and synchronous MCP registry (deny-as-missing, createClusterMeshAppAdapter, createMcpAuth); IdP/2FA security (session-resolver.ts, #695 on a branch); @sentropic/llm-mesh 0.26.1 (seat custody #596) and judge on feat/llm-judge (030198a3); storage (#684) and @sentropic/artifacts (0.1.1). Hosts @sentropic/harness.","[PROPOSAL / SPEC] Gérer dans sentropic (cluster-mesh) la mise en catalogue (SPEC_EVOL_CATALOG.md, SPEC_EVOL_APP_CATALOG.md), le registre MCP et l’hébergement sur @sentropic/artifacts des canvas (UI + interaction IA, SPEC_EVOL_CLUSTER_MESH_MCP_REGISTRY_ARTIFACTS.md #679/#692) ainsi que le modèle de données unique d’annotation (@sentropic/comments #684/#694) ; qualifier d’abord #685 → L5 (#697) en M1 avant d’exposer R2/R7a/R3 en M2. Classement du dernier retour : harnais (outils h2a dont annotate et annotation via comments), mémoire/ontologies et connecteurs à broker dans le catalogue MCP ; IA et catalogues UI/canvas/apps explicites ; sécurité et observabilité séparées des IA ; modèles et artefacts dans le stockage ; Intégration : échanges entre instances Sentropic et services providers (cloud/K8s/mails transactionnels, App Store, registres applicatifs, d’agents et de MCP).":"[PROPOSAL / SPEC] Manage catalogue registration (SPEC_EVOL_CATALOG.md, SPEC_EVOL_APP_CATALOG.md), MCP registry and @sentropic/artifacts hosting for canvases (UI + AI interaction, SPEC_EVOL_CLUSTER_MESH_MCP_REGISTRY_ARTIFACTS.md #679/#692), and the single annotation data model (@sentropic/comments #684/#694), in Sentropic (cluster-mesh). Qualify #685 → L5 (#697) first at M1, before exposing R2/R7a/R3 at M2. Latest-feedback classification: harness (h2a tools including annotate, annotation through comments), memory/ontologies and connectors to broker in the MCP catalogue; explicit AI and UI/canvas/app catalogs; security and observability separate from AI; models and artifacts in storage; Integration covers exchanges between Sentropic instances and provider services (cloud/K8s/transactional email, App Store, application, agent and MCP registries).","Première proposition de Carte des Capacités (C01 à C14) — Proposition initiale des auteurs en attente de la carte du propriétaire":"Initial Capability Map proposal (C01–C14) · Authors’ first proposal, awaiting the owner’s map","Conformément à la règle d’unicité de responsabilité (Clause C-01), chaque capacité désigne un résultat observable et nomme un seul dépôt comme responsable d’intégration proposé (Accountable unique), tout en distinguant explicitement les projets contributeurs aux coutures.":"Under the single-accountability rule (C-01), each capability defines an observable outcome and names exactly one proposed accountable integration repository, while explicitly identifying projects contributing at boundaries.","ID · Capacité système et résultat observable":"ID · System capability and observable outcome","Domaine proposé":"Proposed domain","Responsable principal proposé (Accountable unique)":"Proposed accountable owner (one repository)","Projets contributeurs (coopération aux coutures)":"Contributing projects at integration boundaries","Besoins routés (N01–N33) & contrats vérifiés [CODE] / [SPEC]":"Routed needs (N01–N33) and verified [CODE] / [SPEC] contracts","C01 · Organisation humains–agents : identifier les participants, mandats, espaces de travail et actes permis":"C01 · Human–agent organisation: identify participants, mandates, workspaces and permitted acts","Organisation Humains & Agents":"Human and Agent Organisation","sentropic (authentification IdP/accès) · engram (ontologie des rôles)":"Sentropic (IdP authentication/access) · Engram (role ontology)","C02 · Livraison gouvernée : cadrer le périmètre, distribuer le travail, vérifier mécaniquement et préserver l’acceptation":"C02 · Governed delivery: define scope, distribute work, verify mechanically and preserve acceptance","Traçabilité & Livraison":"Traceability and Delivery","sentropic (code du noyau mécanique @sentropic/harness et profils de dépôts)":"Sentropic (mechanical @sentropic/harness kernel and repository profiles)","N03, N04, N31 · [CODE] @sentropic/track (.track/events.jsonl), @sentropic/harness (scope-check, VerificationRun)":"N03, N04, N31 · [CODE] @sentropic/track (.track/events.jsonl), @sentropic/harness (scope-check, VerificationRun)","C03 · Décisions propriétaires : présenter les alternatives sans biais, consigner le choix et tracer son effet":"C03 · Owner decisions: present unbiased alternatives, record the choice and trace its effect","Décisions & Architecture":"Decisions and Architecture","design-system (rendu <st-decision-dossier>) · sentropic (registres cluster-mesh) · engram (liens connaissance)":"Design System (<st-decision-dossier> rendering) · Sentropic (cluster-mesh registries) · Engram (knowledge links)","N05 · [CODE] @sentropic/focus 0.5.0 (entries.v1.json, sentropic.focus.decision-kit/v4) · [SPEC] élément <st-decision-dossier> Option E":"N05 · [CODE] @sentropic/focus 0.5.0 (entries.v1.json, sentropic.focus.decision-kit/v4) · [SPEC] <st-decision-dossier> element, Option E","C04 · Traçabilité de bout en bout (demande → mise en prod) : relier les 7 sauts sans journal doublon":"C04 · End-to-end traceability (request → production): connect seven hops without a duplicate log","sentropic (@sentropic/artifacts, reçus de déploiement) · engram (faits Git engram-live) · chaque dépôt (Git/release)":"Sentropic (@sentropic/artifacts, deployment receipts) · Engram (engram-live Git facts) · Each repository (Git/release)","N06, N30, N31 · [CODE] lignée Track demand → item → decision → acceptance + harness + artifacts · [SPEC] fermeture E2E en M5":"N06, N30, N31 · [CODE] Track lineage demand → item → decision → acceptance, with harness and artifacts · [SPEC] E2E completion at M5","C05 · Mémoire agentique : rappeler, capturer, admettre, contester, retirer et oublier dans le périmètre autorisé":"C05 · Agentic memory: recall, capture, admit, challenge, withdraw and forget within the authorised scope","Mémoire & Connaissance":"Memory and Knowledge","sentropic (hôte MCP #685 / lot L5 #697, stockage #684) · h2a (contexte agent/session et adoption R5/R6)":"Sentropic (MCP host #685 / L5 #697, storage #684) · h2a (agent/session context and R5/R6 adoption)","N07, N08, N09 · [CODE] src/mcp/memory/contracts.ts:142 (6 outils MCP v3.2), journal D3, graphe filtré D10 (#393) · [PROPOSAL] ContextPack signé":"N07, N08, N09 · [CODE] src/mcp/memory/contracts.ts:142 (six MCP tools v3.2), D3 log, filtered D10 graph (#393) · [PROPOSAL] Signed ContextPack","C06 · Connaissance live du développement : inspecter le code, l’historique Git, les PRs et l’attribution de lignes":"C06 · Live development knowledge: inspect code, Git history, PRs and line attribution","sentropic (persistance cluster-mesh #664 / #684) · h2a (activation explicite par session #342 / #343)":"Sentropic (cluster-mesh persistence #664 / #684) · h2a (explicit activation per session #342 / #343)","N10 · [CODE] @sentropic/engram 0.20.0 engram-live/ (engram-live/line-attribution.ts #389 attribution de lignes, engram-live/symbol-history.ts #390 symboles, #391 20 enquêtes, #400 portage L9-H)":"N10 · [CODE] @sentropic/engram 0.20.0 engram-live/ (engram-live/line-attribution.ts #389 line attribution, engram-live/symbol-history.ts #390 symbols, #391 twenty investigations, #400 L9-H port)","C07 · Architecture et ontologies : gouverner les vocabulaires (dev, track, archi), modéliser les systèmes et vérifier la compatibilité":"C07 · Architecture and ontologies: govern vocabularies (dev, track, archi), model systems and verify compatibility","N11, N12, N13 · [CODE] src/ontology-profile.ts, src/profile-validate.ts, src/merge-graphs.ts, diagram-core 0.1.0, bpmn-canvas 0.3.0 · [SPEC] WP9 & ontology_call":"N11, N12, N13 · [CODE] src/ontology-profile.ts, src/profile-validate.ts, src/merge-graphs.ts, diagram-core 0.1.0, bpmn-canvas 0.3.0 · [SPEC] WP9 and ontology_call","C08 · Découverte et distribution unifiées : trouver toute capacité disponible, son contrat et sa voie d’installation ou d’appel":"C08 · Unified discovery and distribution: find every available capability, its contract, and how to install or call it","Exposition & Surfaces":"Exposure and Surfaces",'h2a (distributeur d’équipement R5/R6 & descripteurs Focus/Track) · engram (descripteurs mémoire/ontologies) · design-system (descripteurs kind="canvas" & <st-*>) · sentropic (projection centrale /catalog & registre MCP synchrone)':'h2a (R5/R6 tooling distributor and Focus/Track descriptors) · Engram (memory/ontology descriptors) · Design System (kind="canvas" and <st-*> descriptors) · Sentropic (central /catalog projection and synchronous MCP registry)',"N14, N15, N16, N24 · [CODE] api/src/services/catalog/types.ts:22,95 (5 kinds : skill, tool, agent, workflow, canvas, #679), cluster-mesh/src/modules/catalog.ts:79, mcp-platform/src/registry.ts:61,128 · [SPEC] SPEC_EVOL_CATALOG.md:99,150,177, SPEC_EVOL_APP_CATALOG.md:5,29,46, SPEC_EVOL_CLUSTER_MESH_CENTRAL_CONTROL_PLANE.md:227,250, SPEC_EVOL_APP_MCP_PROVIDER_PLATFORM.md:91,714,745 (+3 kinds : app, ontology, ui)":"N14, N15, N16, N24 · [CODE] api/src/services/catalog/types.ts:22,95 (five kinds: skill, tool, agent, workflow, canvas, #679), cluster-mesh/src/modules/catalog.ts:79, mcp-platform/src/registry.ts:61,128 · [SPEC] SPEC_EVOL_CATALOG.md:99,150,177, SPEC_EVOL_APP_CATALOG.md:5,29,46, SPEC_EVOL_CLUSTER_MESH_CENTRAL_CONTROL_PLANE.md:227,250, SPEC_EVOL_APP_MCP_PROVIDER_PLATFORM.md:91,714,745 (three additional kinds: app, ontology, ui)","C09 · Composition Canvas (UI + interaction IA) : inscrire au catalogue, exposer via MCP, héberger par-dessus @sentropic/artifacts et monter potentiellement comme UI en prod":"C09 · Canvas composition (UI + AI interaction): catalogue registration, MCP exposure, @sentropic/artifacts hosting and potential production UI mounting