  "format": "profile-parity-corpus/1",
  "notes": [
    "profileArtifact null marks mechanism-level vectors independent of any single profile.",
    "files covers every file under profile-parity-corpus/1/ except manifest.json itself (a manifest cannot pin its own bytes).",
    "The corpus manifest hash pinned by consumers is SHA-256 over manifest.json, recorded at tag time.",
    "Expected outputs are goldens authored from the DESIGN text and checked against the reference comparators, never generated by an implementation."
  ],
  "sourceRepository": "rhanka/bpmn-io-py",
  "sourceTag": "profile-corpus-v1.0.0"
}
