const D4AE9 = ['4AE9 AI Platform'];
const D85BB = ['85BB PCP-GCP'];
const DC9EC = ['C9EC Datahub'];
const AIRBUS = ['Airbus security'];

const A = (repo, kind, evidenceClass, runtimeState, icon, spec) => ({
  card: 'A', kind, repo: [...repo].sort(), labelKind: spec.label ?? 'repo', tint: spec.tint ?? null, evidenceClass, runtimeState, icon,
  code: spec.code ?? '', role: spec.role ?? '', name: spec.name ?? '', detail: spec.detail ?? '', ev: spec.ev ?? [],
});
const BOX = (repo, evidenceClass, runtimeState, spec) => ({
  card: 'box', kind: 'cluster', repo: [...repo].sort(), labelKind: spec.label ?? 'repo', tint: spec.tint ?? null, evidenceClass, runtimeState, icon: 'cluster',
  code: spec.code ?? '', role: '', name: spec.name ?? '', detail: '', ev: spec.ev ?? [],
});
const e = (evidenceClass, runtimeState) => ({ evidenceClass, runtimeState });
const with_ = (base, spec) => ({ ...base, ...spec, ev: spec.ev ?? base.ev });

