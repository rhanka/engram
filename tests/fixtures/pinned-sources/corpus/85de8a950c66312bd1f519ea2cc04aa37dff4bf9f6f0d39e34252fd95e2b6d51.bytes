// Option 2 skeleton, shared by S2-asbuilt and S2-target (same zone ids, same places).
const s2Layout = {
  north: ['PEOPLE', 'WS', 'GCP'], south: 'OUT', southUnder: 'GCP',
  // Fill/align: zones of one row are top-aligned and stretched to the row height.
  fill: true,
  flows: {
    GCP: [['PROJ'], ['SSMPROJ', 'PRODZ']],
    PROJ: [['LBIAP', 'MSGZ', 'RUNZ', 'AEZ'], ['STATEZ', 'VERTEXZ', 'OBSZ'], ['CICDZ', 'NET']],
    RUNZ: [['APP', 'PUSH'], ['CONS', 'CHATCLI'], ['AGENT'], ['QUERY', 'ADMINT']],
    STATEZ: 'grid3', OBSZ: 'grid2', CICDZ: 'row', SSMPROJ: 'row',
    // South band: Airbus AWS hosts the Airbus GitHub, the Airbus GitLab (SCM), Jenkins and JFrog (D2D zoning).
    OUT: 'column', AWSZ: [['GITHUBZ', 'GITLABZ'], ['JENKINS', 'JFROG']], GITHUBZ: 'row', GITLABZ: 'column',
  },
};
const s2TargetLayout = {
  ...s2Layout,
  flows: {
    // PROD environment only (owner, 2026-10-22), after the Google Cloud standard landing zone: the app project (pro),
    // Observability next to the CI/CD project, PROD SSM in the CI/CD project (GenAiR PROD mode: ssm = cicd project).
    GCP: [['PRODZ']],
    // Owner 2026-10-22: two GenAI PCP Platform boxes (CI/CD, Observability) wrapped by the shared-projects box.
    PRODZ: [['PPROZ'], ['PSHARED']], PSHARED: [['PCICD', 'OBSZ', 'PSVPC']], PCICD: 'grid2', OBSZ: 'grid2',
    PPROZ: [['MSGZ', 'RUNZ', 'STATEZ'], ['INGZ', 'VERTEXZ']],
    // Cloud Run reduced to three cards (owner 2026-10-22): GenAiR FastAPI server, ADK agent + RAG tools, Google Chat API integration.
    RUNZ: 'column', STATEZ: 'column', VERTEXZ: 'column', INGZ: 'column',
    OUT: 'row', GITHUBZ: 'row', GENSRC: 'row', GITLABZ: 'column', AWSCI: 'row',
  },
  // Governance-kit layout (decision dossier view, owner 2026-10-22). Rows of items; an item given as an array is a column.
  // Left column: users, Workspace, legend; right column: Google Cloud above AWS, at the same width (stretch).
  kit: {
    root: { axis: 'x', items: [{ axis: 'y', items: ['PEOPLE', 'WS', 'LEGEND'] }, { axis: 'y', stretch: true, items: ['GCP', 'OUT'] }] },
    flows: {
      // Pub/Sub above Ingestion, Cloud Run (three cards stacked), Storage (vertical) above Vertex AI on its right.
      PPROZ: [[['MSGZ', 'INGZ'], 'RUNZ', ['STATEZ', 'VERTEXZ']]],
      // Cloud Run: the three cards stacked, in the order the owner reviewed (Chat API, FastAPI server, agent).
      RUNZ: [['CHATAPI'], ['APP'], ['AGENT']],
      OUT: [['GITHUBZ', 'GITLABZ', 'AWSCI']],
      // The shared-projects wrapper as wide as the pro project (owner 2026-10-22).
      PRODZ: { axis: 'y', stretch: true, items: ['PPROZ', 'PSHARED'] },
    },
  },
};

