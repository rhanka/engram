    'DRIVE|SYNC|Drive API': e('hypothesis', 'not-applicable'),
    'SYNC|DOCS|delta copy': e('hypothesis', 'not-applicable'),
    'DOCS|RAG|import_files': e('hypothesis', 'not-applicable'),
    'VPCSC|HRAGENT|perimeter · min 1 instance': e('hypothesis', 'not-applicable'),
    'CUTTER|SCMREPO|copier generate · update': e('hypothesis', 'not-applicable'),
    'SCMREPO|JENKINS|webhook on push (tbc)': e('hypothesis', 'not-applicable'),
    'JENKINS|HRAGENT|deploy and register (tbc)': e('hypothesis', 'not-applicable'),
    'JENKINS|PSL|apply spoke template (tbc)': e('hypothesis', 'not-applicable'),
  },
};

export const sceneIds = Object.keys(scenes);
export const sceneTitle = id => scenes[id]?.title;
export const sceneMetadata = id => {
  if (!scenes[id]) throw Error(`missing scene metadata ${id}`);
  return scenes[id];
};

// Same contract as the D2D chain: no missing or extra node or edge, closed states,
// single card template A (or container), closed tint, evidence on every item.
export function metadataFor(graph, scene = scenes[graph.id]) {
  if (!scene) throw Error(`missing scene metadata ${graph.id}`);
  const actualNodes = new Set([...graph.groups, ...graph.nodes].map(item => item.id));
  const expectedNodes = new Set(Object.keys(scene.nodes));
  for (const id of actualNodes) if (!expectedNodes.has(id)) throw Error(`${graph.id}: missing node metadata ${id}`);
  for (const id of expectedNodes) if (!actualNodes.has(id)) throw Error(`${graph.id}: extra node metadata ${id}`);
  const groupIds = new Set(graph.groups.map(group => group.id));
  const edges = {};
  for (const edge of graph.edges) {
    const key = `${edge.source}|${edge.target}|${edge.label}`, value = scene.edges[key];
    if (!value) throw Error(`${graph.id}: missing edge metadata ${key}`);
    edges[edge.id] = value;
  }
  if (Object.keys(edges).length !== Object.keys(scene.edges).length) {
    const used = new Set(graph.edges.map(edge => `${edge.source}|${edge.target}|${edge.label}`));
    throw Error(`${graph.id}: extra edge metadata ${Object.keys(scene.edges).filter(key => !used.has(key)).join(', ')}`);
  }
  for (const value of [...Object.values(scene.nodes), ...Object.values(edges)]) {
    if (!EVIDENCE.has(value.evidenceClass) || !RUNTIME.has(value.runtimeState))
      throw Error(`${graph.id}: invalid closed state ${value.evidenceClass}/${value.runtimeState}`);
  }
  for (const [id, value] of Object.entries(scene.nodes)) {
    if (!value.ev?.length) throw Error(`${graph.id}/${id}: no evidence reference`);
    const isGroup = groupIds.has(id);
    if (isGroup !== (value.card === 'box')) throw Error(`${graph.id}/${id}: container and template disagree`);
    if (value.card === 'box') {
      if (value.role) throw Error(`${graph.id}/${id}: a container carries no role title`);
      continue;
    }
    if (value.card !== 'A') throw Error(`${graph.id}/${id}: unknown card template ${value.card}`);
    if (!value.code || !value.role || !value.name || !value.detail) throw Error(`${graph.id}/${id}: card needs code, role, name and detail`);
    if (value.name.includes(value.code)) throw Error(`${graph.id}/${id}: code repeated inside the name`);
    if (!roleIsShort(value.role)) throw Error(`${graph.id}/${id}: role title "${value.role}" is not two-by-two short`);
    if (value.tint !== null && !TINTS.has(value.tint)) throw Error(`${graph.id}/${id}: unknown tint ${value.tint}`);
  }
  // A decided (clean) scene carries no removed card, no risk frame and no dashed option link.
  if (scene.clean) {
    const red = Object.entries(scene.nodes).filter(([, value]) => value.tint === 'removed' || value.tint === 'risk').map(([id]) => id);
    if (red.length) throw Error(`${graph.id}: clean scene with removed/risk tints: ${red.join(', ')}`);
    const dashed = graph.edges.filter(edge => edge.dashed).map(edge => `${edge.source}→${edge.target}`);
    if (dashed.length) throw Error(`${graph.id}: clean scene with dashed links: ${dashed.join(', ')}`);
  }
  for (const id of [...scene.layout.north, scene.layout.south].filter(Boolean))
    if (!actualNodes.has(id)) throw Error(`${graph.id}: layout zone ${id} is not in the graph`);
  return { nodes: scene.nodes, edges, layout: scene.layout };
}

export function decorateGraph(graph, scene) {
  const metadata = metadataFor(graph, scene);
  for (const item of [...graph.groups, ...graph.nodes]) item.metadata = metadata.nodes[item.id];
  for (const edge of graph.edges) edge.metadata = metadata.edges[edge.id];
  graph.layout = metadata.layout;
  return graph;
}
