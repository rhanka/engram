{
  "$type": "bpmn:Definitions",
  "id": "Defs_Kite",
  "targetNamespace": "urn:example:functions-workbench:v1",
  "rootElements": [
    {
      "$type": "bpmn:Process",
      "id": "Process_Kite",
      "isExecutable": false,
      "flowElements": [
        {
          "$type": "bpmn:StartEvent",
          "id": "Start_Kite",
          "outgoing": [
            "Flow_1"
          ]
        },
        {
          "$type": "bpmn:Task",
          "id": "Task_Review",
          "name": "Review paper kite",
          "incoming": [
            "Flow_1"
          ],
          "outgoing": [
            "Flow_2"
          ]
        },
        {
          "$type": "bpmn:EndEvent",
          "id": "End_Kite",
          "incoming": [
            "Flow_2"
          ]
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "Flow_1",
          "sourceRef": "Start_Kite",
          "targetRef": "Task_Review"
        },
        {
          "$type": "bpmn:SequenceFlow",
          "id": "Flow_2",
          "sourceRef": "Task_Review",
          "targetRef": "End_Kite"
        }
      ]
    },
    {
      "$type": "bpmn:Process",
      "id": "Process_Lantern"
    },
    {
      "$type": "bpmn:Collaboration",
      "id": "Collab_Kite",
      "participants": [
        {
          "$type": "bpmn:Participant",
          "id": "Pool_A",
          "processRef": "Process_Kite"
        },
        {
          "$type": "bpmn:Participant",
          "id": "Pool_B",
          "processRef": "Process_Lantern"
        }
      ],
      "messageFlows": [
        {
          "$type": "bpmn:MessageFlow",
          "id": "Message_Kite",
          "sourceRef": "Pool_A",
          "targetRef": "Pool_B"
        }
      ]
    },
    {
      "$type": "bpmn:Resource",
      "id": "Resource_Paper",
      "name": "Paper desk"
    }
  ]
}
