      "cases": [
        {
          "name": "bad-clock-cohort",
          "validator": "validateCohort",
          "object": {
            "schema": "engram.time-reference/cohort/1",
            "cohortKey": "astra-merged-desc/1",
            "repo": "rhanka/h2a",
            "metric": "ci_time",
            "manifestRef": {
