{
  "contract": "SPEC-time-reference-contract.md (Tour 3 revision, 2026-10-18)",
  "note": "Each normative rule is encoded ONCE here as test data with its spec section. Tests read this fixture, never production tables.",
  "rules": [
    {
      "id": "F01",
      "spec": "§6.0",
      "title": "Recursive closed schemas: every nested object is closed, every typed array constrains its elements",
      "closedSchemaPaths": [
        "CiCheckBatchV1.properties.checks.items",
        "CohortV1.properties.fingerprint",
        "CohortV1.properties.manifestRef",
        "CohortV1.properties.window",
        "CollectionManifestV1.properties.quarantine.items",
        "CommittedExportV1.properties.budgets.items",
        "CommittedExportV1.properties.estimates.items",
        "CommittedExportV1.properties.generator",
        "CommittedExportV1.properties.milestones.items",
        "CommittedExportV1.properties.profileRef",
        "CommittedExportV1.properties.provenance.items",
        "CommittedExportV1.properties.series.items",
        "CommittedExportV1.properties.window",
        "DeliveryMilestonesV1.properties.installMilestones.items",
        "DeliveryMilestonesV1.properties.mergeMilestone",
        "PullRequestTimingV1.properties.commits.items",
        "QuantileSetV1.properties.nEff",
        "ReviewWaveManifestV1.properties.reviewerRuns.items",
        "TimingEstimateV1.properties.freshness",
        "TimingEstimateV1.properties.quantiles",
        "TimingEstimateV1.properties.seriesRef",
        "TimingSeriesV1.properties.cohortRef",
        "TimingSeriesV1.properties.exclusions.items",
        "TimingSeriesV1.properties.fingerprint",
        "TimingSeriesV1.properties.quantiles",
        "TimingSeriesV1.properties.window"
      ]
    },
    {
      "id": "F02",
      "spec": "§6.0, §11",
      "title": "Recursive validator closure: nested undeclared fields, required fields and element types fail",
      "nestedCases": [
        {
          "base": "cohort",
          "path": "manifestRef.memoryId",
          "value": "m-1",
          "code": "undeclared-field"
        },
        {
          "base": "cohort",
          "path": "window.extra",
          "value": 1,
          "code": "undeclared-field"
        },
        {
          "base": "series",
          "path": "cohortRef.memoryId",
          "value": "m-1",
          "code": "undeclared-field"
        },
        {
          "base": "series",
          "path": "window.extra",
          "value": 1,
          "code": "undeclared-field"
        },
        {
          "base": "series",
          "path": "exclusions.0.note",
          "value": "x",
          "code": "undeclared-field"
        },
        {
          "base": "estimate",
          "path": "seriesRef.extra",
          "value": 1,
          "code": "undeclared-field"
        },
        {
          "base": "estimate",
          "path": "freshness.extra",
          "value": 1,
          "code": "undeclared-field"
        },
        {
          "base": "export",
          "path": "profileRef.extra",
          "value": 1,
          "code": "undeclared-field"
        },
        {
          "base": "export",
          "path": "generator.extra",
          "value": 1,
          "code": "undeclared-field"
        },
        {
          "base": "export",
          "path": "window.extra",
          "value": 1,
          "code": "undeclared-field"
        },
        {
          "base": "batch",
          "path": "checks.0.extra",
          "value": 1,
          "code": "undeclared-field"
        },
        {
          "base": "pr",
          "path": "commits.0.extra",
          "value": 1,
          "code": "undeclared-field"
        },
        {
          "base": "wave",
          "path": "reviewerRuns.0.extra",
          "value": 1,
          "code": "undeclared-field"
        },
        {
          "base": "manifest",
          "path": "quarantine.0.extra",
          "value": 1,
          "code": "undeclared-field"
        },
        {
          "base": "receipt",
          "path": "evidenceDigests.0",
          "value": "not-a-digest",
          "code": "bad-digest"
        },
        {
          "base": "batch",
          "path": "checks.0.id",
          "value": null,
          "code": "bad-type"
        },
        {
          "base": "manifest",
          "path": "quarantine.0.id",
          "value": null,
          "code": "bad-type"
        }
      ]
    },
    {
      "id": "F03",
      "spec": "§8.1",
      "title": "Regeneration recomputes and compares every published figure and maximum, in series and in estimates",
      "cases": [
        {
          "mutation": "estimates.0.quantiles.p95Seconds",
          "code": "quantile-mismatch"
        },
        {
          "mutation": "estimates.0.quantiles.maxSeconds",
          "code": "quantile-mismatch"
        },
        {
          "mutation": "series.0.quantiles.maxSeconds",
          "code": "quantile-mismatch"
        },
        {
          "mutation": "series.0.quantiles.p50Seconds",
          "code": "quantile-mismatch"
        }
      ]
    },
    {
      "id": "F04",
      "spec": "§6.1",
      "title": "Supplied samples authenticate against the pinned snapshot digest before any recomputation",
      "cases": [
        {
          "mutation": "renamed-sample-ids",
          "code": "sample-auth-mismatch"
        },
        {
          "mutation": "moved-sample-value",
          "code": "sample-auth-mismatch"
        }
      ]
    },
    {
      "id": "F05",
      "spec": "§4.3, §6.5",
      "title": "Effective tail thresholds and required qualifications",
      "cases": [
        {
          "name": "one-sample calibrated P95",
          "support": "calibrated",
          "sampleCount": 1,
          "nEff": {
            "numerator": "1",
            "denominator": "1"
          },
          "p50Seconds": 7,
          "p80Seconds": 7,
          "p95Seconds": 7,
          "expectOk": false,
          "code": "weak-tail-support"
        },
        {
          "name": "calibrated P95 on n=20",
          "support": "calibrated",
          "sampleCount": 20,
          "nEff": {
            "numerator": "20",
            "denominator": "1"
          },
          "p50Seconds": 1,
          "p80Seconds": 2,
          "p95Seconds": 3,
          "expectOk": false,
          "code": "weak-tail-support"
        },
        {
          "name": "calibrated P95 on n=100",
          "support": "calibrated",
          "sampleCount": 100,
          "nEff": {
            "numerator": "100",
            "denominator": "1"
          },
          "p50Seconds": 1,
          "p80Seconds": 2,
          "p95Seconds": 3,
          "tailQualification": "nEff 100/1 over 4 campaigns",
          "expectOk": true
        },
        {
          "name": "descriptive tail without qualification",
          "support": "descriptive",
          "sampleCount": 20,
          "nEff": {
            "numerator": "20",
            "denominator": "1"
          },
          "p50Seconds": 1,
          "p80Seconds": 2,
          "p95Seconds": 3,
          "expectOk": false,
          "code": "missing-tail-reason"
        },
        {
          "name": "descriptive tail with qualification",
          "support": "descriptive",
          "sampleCount": 20,
          "nEff": {
            "numerator": "20",
            "denominator": "1"
          },
          "p50Seconds": 1,
          "p80Seconds": 2,
          "p95Seconds": 3,
          "tailQualification": "nEff 20/1: descriptive tail, 1 campaign",
          "expectOk": true
        },
        {
          "name": "uncalibrated-conditional without qualification",
          "support": "uncalibrated-conditional",
          "sampleCount": 20,
          "nEff": {
            "numerator": "20",
            "denominator": "1"
          },
          "p50Seconds": 1,
          "p80Seconds": 2,
          "p95Seconds": 3,
          "expectOk": false,
          "code": "missing-tail-reason"
        }
      ]
    },
    {
      "id": "F06",
      "spec": "§6.7",
      "title": "Exactly one matching provenance record per published figure",
      "cases": [
        {
          "mutation": "provenance.0.quantileMethod",
          "value": "weighted-ecdf/1",
          "code": "provenance-mismatch"
        },
        {
          "mutation": "provenance.0.estimatorVersion",
          "value": "e2",
          "code": "provenance-mismatch"
        },
        {
          "mutation": "provenance.0.snapshotDigest",
          "value": "sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
          "code": "provenance-mismatch"
        },
        {
          "mutation": "duplicate-provenance-s1",
          "code": "duplicate-provenance"
        }
      ]
    }
  ],
