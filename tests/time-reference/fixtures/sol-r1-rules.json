        "CommittedExportV1.properties.provenance.items",
        "CommittedExportV1.properties.series.items",
        "CommittedExportV1.properties.window",
        "DeliveryMilestonesV1.properties.installMilestones.items",
        "DeliveryMilestonesV1.properties.mergeMilestone",
        "PullRequestTimingV1.properties.commits.items",
        "QuantileSetV1.properties.nEff",
        "ReviewWaveManifestV1.properties.reviewerRuns.items",
        "TimingEstimateV1.properties.freshness",
