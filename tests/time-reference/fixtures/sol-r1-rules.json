              "to": "2026-10-18T07:48:00Z"
            },
            "fingerprint": {
              "configDigest": "unknown",
              "effort": "unknown",
              "jobSet": "unknown",
              "model": "unknown",
              "reviewPolicy": "unknown",
              "runner": "unknown",
              "suiteShardSet": "unknown",
              "toolchain": "unknown",
              "workflowPath": "unknown"
            },
            "purpose": "retrospective-frozen-evidence"
          },
          "code": "bad-enum"
        },
        {
