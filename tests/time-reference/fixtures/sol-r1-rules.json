{
  "contract": "SPEC-time-reference-contract.md (Tour 3 revision, 2026-10-18)",
  "note": "Each normative rule is encoded ONCE here as test data with its spec section. Tests read this fixture, never production tables.",
  "rules": [
    {
      "id": "F01",
      "spec": "§6.0",
      "title": "Recursive closed schemas: every nested object is closed, every typed array constrains its elements",
      "closedSchemaPaths": [
        "CiCheckBatchV1.properties.checks.items",
        "CohortV1.properties.fingerprint",
        "CohortV1.properties.manifestRef",
        "CohortV1.properties.window",
        "CollectionManifestV1.properties.quarantine.items",
        "CommittedExportV1.properties.budgets.items",
        "CommittedExportV1.properties.estimates.items",
        "CommittedExportV1.properties.generator",
        "CommittedExportV1.properties.milestones.items",
        "CommittedExportV1.properties.profileRef",
        "CommittedExportV1.properties.provenance.items",
        "CommittedExportV1.properties.series.items",
        "CommittedExportV1.properties.window",
        "DeliveryMilestonesV1.properties.installMilestones.items",
        "DeliveryMilestonesV1.properties.mergeMilestone",
        "PullRequestTimingV1.properties.commits.items",
        "QuantileSetV1.properties.nEff",
        "ReviewWaveManifestV1.properties.reviewerRuns.items",
        "TimingEstimateV1.properties.freshness",
        "TimingEstimateV1.properties.quantiles",
        "TimingEstimateV1.properties.seriesRef",
        "TimingSeriesV1.properties.cohortRef",
        "TimingSeriesV1.properties.exclusions.items",
        "TimingSeriesV1.properties.fingerprint",
        "TimingSeriesV1.properties.quantiles",
        "TimingSeriesV1.properties.window"
      ]
    },
    {
      "id": "F02",
      "spec": "§6.0, §11",
      "title": "Recursive validator closure: nested undeclared fields, required fields and element types fail",
      "nestedCases": [
        {
          "base": "cohort",
          "path": "manifestRef.memoryId",
          "value": "m-1",
          "code": "undeclared-field"
        },
        {
          "base": "cohort",
          "path": "window.extra",
          "value": 1,
          "code": "undeclared-field"
        },
        {
          "base": "series",
          "path": "cohortRef.memoryId",
          "value": "m-1",
          "code": "undeclared-field"
        },
        {
          "base": "series",
          "path": "window.extra",
          "value": 1,
          "code": "undeclared-field"
        },
        {
          "base": "series",
          "path": "exclusions.0.note",
          "value": "x",
          "code": "undeclared-field"
        },
        {
          "base": "estimate",
          "path": "seriesRef.extra",
          "value": 1,
          "code": "undeclared-field"
        },
        {
          "base": "estimate",
          "path": "freshness.extra",
          "value": 1,
          "code": "undeclared-field"
        },
        {
          "base": "export",
          "path": "profileRef.extra",
          "value": 1,
          "code": "undeclared-field"
        },
        {
          "base": "export",
          "path": "generator.extra",
          "value": 1,
          "code": "undeclared-field"
        },
        {
          "base": "export",
          "path": "window.extra",
          "value": 1,
          "code": "undeclared-field"
        },
        {
          "base": "batch",
          "path": "checks.0.extra",
          "value": 1,
          "code": "undeclared-field"
        },
        {
          "base": "pr",
          "path": "commits.0.extra",
          "value": 1,
          "code": "undeclared-field"
        },
        {
          "base": "wave",
          "path": "reviewerRuns.0.extra",
          "value": 1,
          "code": "undeclared-field"
        },
        {
          "base": "manifest",
          "path": "quarantine.0.extra",
          "value": 1,
          "code": "undeclared-field"
        },
        {
          "base": "receipt",
          "path": "evidenceDigests.0",
          "value": "not-a-digest",
          "code": "bad-digest"
        },
        {
          "base": "batch",
          "path": "checks.0.id",
          "value": null,
          "code": "bad-type"
        },
        {
          "base": "manifest",
          "path": "quarantine.0.id",
          "value": null,
          "code": "bad-type"
        }
      ]
    },
    {
      "id": "F03",
      "spec": "§8.1",
      "title": "Regeneration recomputes and compares every published figure and maximum, in series and in estimates",
      "cases": [
        {
          "mutation": "estimates.0.quantiles.p95Seconds",
          "code": "quantile-mismatch"
        },
        {
          "mutation": "estimates.0.quantiles.maxSeconds",
          "code": "quantile-mismatch"
        },
        {
          "mutation": "series.0.quantiles.maxSeconds",
          "code": "quantile-mismatch"
        },
        {
          "mutation": "series.0.quantiles.p50Seconds",
          "code": "quantile-mismatch"
        }
      ]
    },
    {
      "id": "F04",
      "spec": "§6.1",
      "title": "Supplied samples authenticate against the pinned snapshot digest before any recomputation",
      "cases": [
        {
          "mutation": "renamed-sample-ids",
          "code": "sample-auth-mismatch"
        },
        {
          "mutation": "moved-sample-value",
          "code": "sample-auth-mismatch"
        }
      ]
    },
    {
      "id": "F05",
      "spec": "§4.3, §6.5",
      "title": "Effective tail thresholds and required qualifications",
      "cases": [
        {
          "name": "one-sample calibrated P95",
          "support": "calibrated",
          "sampleCount": 1,
          "nEff": {
            "numerator": "1",
            "denominator": "1"
          },
          "p50Seconds": 7,
          "p80Seconds": 7,
          "p95Seconds": 7,
          "expectOk": false,
          "code": "weak-tail-support"
        },
        {
          "name": "calibrated P95 on n=20",
          "support": "calibrated",
          "sampleCount": 20,
          "nEff": {
            "numerator": "20",
            "denominator": "1"
          },
          "p50Seconds": 1,
          "p80Seconds": 2,
          "p95Seconds": 3,
          "expectOk": false,
          "code": "weak-tail-support"
        },
        {
          "name": "calibrated P95 on n=100",
          "support": "calibrated",
          "sampleCount": 100,
          "nEff": {
            "numerator": "100",
            "denominator": "1"
          },
          "p50Seconds": 1,
          "p80Seconds": 2,
          "p95Seconds": 3,
          "tailQualification": "nEff 100/1 over 4 campaigns",
          "expectOk": true
        },
        {
          "name": "descriptive tail without qualification",
          "support": "descriptive",
          "sampleCount": 20,
          "nEff": {
            "numerator": "20",
            "denominator": "1"
          },
          "p50Seconds": 1,
          "p80Seconds": 2,
          "p95Seconds": 3,
          "expectOk": false,
          "code": "missing-tail-reason"
        },
        {
          "name": "descriptive tail with qualification",
          "support": "descriptive",
          "sampleCount": 20,
          "nEff": {
            "numerator": "20",
            "denominator": "1"
          },
          "p50Seconds": 1,
          "p80Seconds": 2,
          "p95Seconds": 3,
          "tailQualification": "nEff 20/1: descriptive tail, 1 campaign",
          "expectOk": true
        },
        {
          "name": "uncalibrated-conditional without qualification",
          "support": "uncalibrated-conditional",
          "sampleCount": 20,
          "nEff": {
            "numerator": "20",
            "denominator": "1"
          },
          "p50Seconds": 1,
          "p80Seconds": 2,
          "p95Seconds": 3,
          "expectOk": false,
          "code": "missing-tail-reason"
        }
      ]
    },
    {
      "id": "F06",
      "spec": "§6.7",
      "title": "Exactly one matching provenance record per published figure",
      "cases": [
        {
          "mutation": "provenance.0.quantileMethod",
          "value": "weighted-ecdf/1",
          "code": "provenance-mismatch"
        },
        {
          "mutation": "provenance.0.estimatorVersion",
          "value": "e2",
          "code": "provenance-mismatch"
        },
        {
          "mutation": "provenance.0.snapshotDigest",
          "value": "sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
          "code": "provenance-mismatch"
        },
        {
          "mutation": "duplicate-provenance-s1",
          "code": "duplicate-provenance"
        }
      ]
    },
    {
      "id": "F07",
      "spec": "§7.2",
      "title": "Validated receipts and frozen target declarations bind to the identified context",
      "cases": [
        {
          "mutation": "receipt.repo",
          "value": "evil/other",
          "reason": "foreign-repo-receipt"
        },
        {
          "mutation": "receipt.lotOccurrence",
          "value": "occ-9",
          "reason": "foreign-lot-receipt"
        },
        {
          "mutation": "receipt.mergeSha",
          "value": "other-merge",
          "reason": "foreign-merge-receipt"
        },
        {
          "mutation": "qual.expectedMergeSha",
          "value": "other-merge",
          "reason": "declaration-mismatch"
        }
      ]
    },
    {
      "id": "F08",
      "spec": "§6.9",
      "title": "Known installation actuals resolve to a matching qualified receipt",
      "cases": [
        {
          "mutation": "drop-receiptRef",
          "code": "missing-receipt-ref"
        },
        {
          "mutation": "no-receipt-supplied",
          "code": "unresolved-receipt"
        }
      ]
    },
    {
      "id": "F09",
      "spec": "§6.11",
      "title": "Duplicate wave identities and foreign-lot waves are rejected",
      "cases": [
        {
          "mutation": "duplicate-roundId",
          "code": "duplicate-wave"
        },
        {
          "mutation": "foreign-wave-repo",
          "code": "foreign-wave-repo"
        },
        {
          "mutation": "foreign-wave-lot",
          "code": "foreign-wave-lot"
        }
      ]
    },
    {
      "id": "F10",
      "spec": "TR-06",
      "title": "Duplicate cohort members are rejected before counting",
      "cases": [
        {
          "mutation": "duplicate-memberIds",
          "code": "duplicate-member"
        }
      ]
    },
    {
      "id": "F11",
      "spec": "§6.4",
      "title": "Fingerprints carry every specified regime component, unattested ones unknown",
      "cases": [
        {
          "mutation": "empty-fingerprint",
          "code": "missing-fingerprint-component"
        },
        {
          "mutation": "dropped-jobSet",
          "code": "missing-fingerprint-component"
        },
        {
          "mutation": "empty-string-component",
          "code": "missing-fingerprint-component"
        }
      ]
    },
    {
      "id": "F12",
      "spec": "§6.1",
      "title": "sourceRevision is a full immutable commit SHA",
      "cases": [
        {
          "mutation": "main",
          "value": "main",
          "code": "bad-source-revision"
        },
        {
          "mutation": "short-sha",
          "value": "46b82b4",
          "code": "bad-source-revision"
        }
      ]
    },
    {
      "id": "F13",
      "spec": "§12.2",
      "title": "Supported profile pins and matching mapping versions",
      "cases": [
        {
          "mutation": "export-profile-version-2",
          "value": "2",
          "code": "unsupported-profile-version"
        },
        {
          "mutation": "mapping-version-9",
          "value": "9.9.9",
          "code": "unsupported-mapping-version"
        },
        {
          "mutation": "mapping-profile-version-2",
          "value": "2",
          "code": "mapping-profile-mismatch"
        }
      ]
    },
    {
      "id": "F14",
      "spec": "§6.2 A6",
      "title": "unavailable commits require an attested attempt with a documented cause",
      "cases": [
        {
          "mutation": "no-attempt",
          "code": "missing-collection-attempt"
        },
        {
          "mutation": "empty-cause",
          "code": "missing-unavailability-cause"
        }
      ]
    },
    {
      "id": "F15",
      "spec": "§3.3",
      "title": "Incoherent CI intervals are quarantined, durations are integer seconds",
      "cases": [
        {
          "mutation": "negative-gap-service",
          "code": null
        },
        {
          "mutation": "fractional-envelope",
          "code": null
        },
        {
          "mutation": "zero-gap-last-check",
          "code": null
        }
      ]
    },
    {
      "id": "F18",
      "spec": "§5.2",
      "title": "Non-string weights are rejected, never coerced",
      "cases": [
        {
          "mutation": "numeric-weight"
        }
      ]
    },
    {
      "id": "F19",
      "spec": "§5.1",
      "title": "The full probability domain parses exactly, including exponent forms",
      "cases": [
        {
          "p": "1e-7",
          "nearestRankOf": [
            5,
            9
          ],
          "expected": 5
        },
        {
          "p": "0.5",
          "nearestRankOf": [
            5,
            9
          ],
          "expected": 5
        }
      ]
    }
  ],
  "shared": {
