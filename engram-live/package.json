{
  "name": "@sentropic/engram-live",
  "version": "0.2.0-pre.1",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Engram neutral live collector package — logical code/Git facts with injected capabilities (no host, driver, CLI or model dependency). Qualified runtimes: Node 20, 22 and 24 on Linux only (engines/os are bounded and enforced by scripts/check-live-package.mjs).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhanka/engram.git",
    "directory": "engram-live"
  },
  "homepage": "https://github.com/rhanka/engram",
  "bugs": {
    "url": "https://github.com/rhanka/engram/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./integration": {
      "types": "./dist/integration.d.ts",
      "import": "./dist/integration.js"
    }
  },
  "files": [
    "dist",
    "grammar-manifest.json"
  ],
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || ^24.0.0"
  },
  "os": [
    "linux"
  ],
  "scripts": {
    "build": "node ../scripts/build-live.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
