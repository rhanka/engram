          "sentropic.engram.memory-tools/2020-12-v1"
        ],
        "requiredHostFeatures": [
          "invocation",
          "authorization",
          "domainPolicy",
          "engine",
          "mutationRecovery",
          "confirmation",
          "audit",
          "pagination",
          "lifecycle"
        ],
        "optionalHostFeatures": []
      },
      "parameters": {
        "schemaVersion": "1.0.0",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "https://sentropic.dev/schemas/engram/memory/parameters-v1.json",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "hostBindingRef"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "const": "embedded-local",
              "default": "embedded-local"
            },
            "hostBindingRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            }
          }
        },
        "defaults": {
          "mode": "embedded-local"
        }
      },
      "bindings": [
        {
          "key": "invocation",
          "contract": "MemoryInvocationBindingV1",
          "required": true
        },
        {
          "key": "authorization",
          "contract": "AuthorizationPort",
          "required": true
        },
        {
          "key": "domainPolicy",
          "contract": "MemoryDomainPolicyV1",
          "required": true
        },
        {
          "key": "engine",
          "contract": "GuardedMemoryPortV2+MemoryRecallPortV3+MemoryReadPortV1",
          "required": true
        },
        {
          "key": "mutationRecovery",
          "contract": "MemoryMutationRecoveryPortV1",
          "required": true
        },
        {
          "key": "confirmation",
          "contract": "MemoryConfirmationAssuranceV1+MemoryConfirmationContinuationV1",
          "required": true
        },
        {
          "key": "audit",
          "contract": "MemoryAuditSinkV1",
          "required": true
        },
        {
          "key": "pagination",
          "contract": "MemoryPaginationStoreV1",
          "required": true
        },
        {
          "key": "lifecycle",
          "contract": "MemoryLifecyclePortsV1",
          "required": true
        }
